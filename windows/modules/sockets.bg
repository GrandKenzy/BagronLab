clause Privacy "public"

AF_UNSPEC: const int32 = 0
SOCKET_ERROR: const int32 = -1
INVALID_SOCKET: const usize = 18446744073709551615
WINSOCK_VERSION: const uint16 = 514

AF_INET: const int32 = 2
AF_INET6: const int32 = 23
SOCK_STREAM: const int32 = 1
IPPROTO_TCP: const int32 = 6


@align(8)
struct ADDRINFO:
    ; EN: ADDRINFO view from network consumers.
    ; Windows places ai_canname before ai_addr in the native structure 
    ;
    ; ES: Vista de ADDRINFO para consumidores de red.
    ; Windows coloca ai_canonname antes de ai_addr en la estructura nativa

    ai_flags: int32
    ai_family: int32
    ai_socktype: int32
    ai_protocol: int32
    ai_addrlen: usize
    ai_canonname *: const char
    ai_addr *: const char
    ai_next *: ADDRINFO

@align(8)
struct WSADATA:
    ; EN: WSADATA structure from windows AMD64
    ; ABI size expected: 408 bytes, 8 align
    ; 
    ; ES: Estructura WSADATA para Windows AMD64
    ; Tamaño ABI esperado: 408 bytes, alineación 8.
    wVersion: uint16
    wHighVersion: uint16
    szDescription: char[257]
    szSystemStatus: char[129]
    iMaxSockets: uint16
    iMaxUdpDg: uint16
    lpVendorInfo *: char

extern windows "ws2_32":
    

    WSACleanup() int32
    WSAGetLastError() int32
    listen(sock: usize, backlog: int32) int32
    closesocket(sock: usize) int32
    freeaddrinfo(result *: ADDRINFO) void
    htons(port: int32) uint16

    WSAStartup(
        wVersionRequired: uint16,
        lpWSAData *: WSADATA
    ) int32
    
    socket(
        af: int32,
        kind: int32,
        protocol: int32
    ) usize

    bind(
        sock: usize,
        data *: void,
        length: int32
    ) int32

    connect(
        sock: usize,
        data *: const char,
        length: int32
    ) int32

    accept(
        sock: usize,
        data *: char,
        length *: int32
    ) usize

    setsockopt(
        sock: usize,
        level: int32,
        option: int32,
        value *: void,
        value_length: int32
    ) int32

    send(
        sock: usize,
        buf *: const char,
        len: int32,
        flags_: int32
    ) int32

    recv(
        sock: usize,
        buf *: char,
        len: int32,
        flags_: int32
    ) int32

    getaddrinfo(
        node *: const char,
        service *: const char,
        hints *: ADDRINFO,
        result **: ADDRINFO
    ) int32


; EN: Adapters shared by the HTTP client and future protocols
;
; ES: Adaptadores compartidos por el cliente HTTP y futuros protocolos
@unsafe
public inline func Open(family: int32, kind: int32, protocol: int32) usize:
    ; EN : Creates a native socket descriptor using Winsock.
    ; Returns INVALID_SOCKET on failure.
    ;
    ; ES : Crea un descriptor de socket nativo mediante Winsock.
    ; Devuelve INVALID_SOCKET en caso de error.
    return socket(family, kind, protocol)

@unsafe
public inline func Connect(handle: usize, address *: const char, length: int32) int32:
    ; EN : Establishes a connection to a specified socket address.
    ; Returns 0 on success, or SOCKET_ERROR on failure.
    ;
    ; ES : Establece una conexión a una dirección de socket especificada.
    ; Devuelve 0 en caso de éxito, o SOCKET_ERROR en caso de error.
    return connect(handle, address, length)

@unsafe
public inline func Bind(handle: usize, address *: void, length: int32) int32:
    ; EN : Associates a local address with a socket descriptor.
    ; Returns 0 on success, or SOCKET_ERROR on failure.
    ;
    ; ES : Asocia una dirección local a un descriptor de socket.
    ; Devuelve 0 en caso de éxito, o SOCKET_ERROR en caso de error.
    return bind(handle, address, length)

@unsafe
public inline func Listen(handle: usize, backlog: int32) int32:
    ; EN : Places a socket in a state listening for incoming connections.
    ; Returns 0 on success, or SOCKET_ERROR on failure.
    ;
    ; ES : Coloca un socket en estado de escucha para conexiones entrantes.
    ; Devuelve 0 en caso de éxito, o SOCKET_ERROR en caso de error.
    return listen(handle, backlog)

@unsafe
public inline func Accept(handle: usize, address *: void, length *: int32) usize:
    ; EN : Accepts an incoming connection request on a listening socket.
    ; Returns the new socket descriptor or INVALID_SOCKET on error.
    ;
    ; ES : Acepta una solicitud de conexión entrante en un socket en escucha.
    ; Devuelve el descriptor nuevo o INVALID_SOCKET en caso de error.
    return accept(handle, address, length)

@unsafe
public func set_timeout(handle: usize, timeout_ms: int32) int32:
    ; EN : Configures send and receive timeouts on a socket in milliseconds.
    ; Returns 0 on success, or -1 on invalid parameter or socket error.
    ;
    ; ES : Configura tiempos de espera de envío y recepción en milisegundos.
    ; Devuelve 0 en caso de éxito, o -1 en caso de parámetro inválido o error.
    if timeout_ms < 1:
        return -1
    
    receive_option: int32 = 4102
    send_option: int32 = 4101
    socket_level: int32 = 65535
    receive_result: int32 = setsockopt(handle, socket_level, receive_option, $timeout_ms, 4)
    send_result: int32 = setsockopt(handle, socket_level, send_option, $timeout_ms, 4)
    if receive_result != 0 || send_result != 0:
        return -1
    return 0

@unsafe
public inline func Send(handle: usize, buffer *: const char, length: int32) int32:
    ; EN : Sends data on a connected socket descriptor.
    ; Returns the number of bytes sent, or SOCKET_ERROR on failure.
    ;
    ; ES : Envía datos a través de un descriptor de socket conectado.
    ; Devuelve el número de bytes enviados, o SOCKET_ERROR en caso de error.
    return send(handle, buffer, length, 0)

@unsafe
public inline func Recv(handle: usize, buffer *: char, length: int32) int32:
    ; EN : Receives data from a connected socket descriptor into a buffer.
    ; Returns the number of bytes received, 0 on disconnect, or SOCKET_ERROR.
    ;
    ; ES : Recibe datos desde un socket conectado en un buffer.
    ; Devuelve el número de bytes recibidos, 0 al desconectar, o SOCKET_ERROR.
    return recv(handle, buffer, length, 0)

@unsafe
public inline func Close(handle: usize) int32:
    ; EN : Closes an open socket descriptor.
    ; Returns 0 on success, or SOCKET_ERROR on failure.
    ;
    ; ES : Cierra un descriptor de socket abierto.
    ; Devuelve 0 en caso de éxito, o SOCKET_ERROR en caso de error.
    return closesocket(handle)

@unsafe
public inline func GetAddrInfo(
    node *: const char,
    service *: const char,
    hints *: ADDRINFO,
    result **: ADDRINFO
) int32:
    ; EN : Resolves hostnames and service port names into address structures.
    ;
    ; ES : Resuelve nombres de host y servicio a estructuras de direcciones.
    return getaddrinfo(node, service, hints, result)

@unsafe
public inline func ReleaseAddrInfo(result *: ADDRINFO) void:
    ; EN : Frees address structures allocated dynamically by GetAddrInfo.
    ;
    ; ES : Libera estructuras de direcciones asignadas dinámicamente por GetAddrInfo.
    freeaddrinfo(result)

@unsafe
public func Startup() int32:
    ; EN : Initializes the Winsock 2.2 subsystem for the process.
    ; Returns 0 on success, or non-zero error code on failure.
    ;
    ; ES : Inicializa el subsistema Winsock 2.2 para el proceso.
    ; Devuelve 0 en caso de éxito, o código de error distinto de cero.
    data: WSADATA
    result: int32 = WSAStartup(WINSOCK_VERSION, $data)

    if result != 0:
        return result

    if data.wVersion != WINSOCK_VERSION:
        WSACleanup()
        return SOCKET_ERROR
    return 0


@unsafe
public inline func Cleanup() int32:
    ; EN : Terminates use of the Winsock 2 subsystem.
    ;
    ; ES : Finaliza el uso del subsistema Winsock 2.
    return WSACleanup()

@unsafe
public inline func NetworkPort(port: int32) uint16:
    ; EN : Converts a port number from host byte order to network byte order.
    ;
    ; ES : Convierte un número de puerto de orden de host a orden de red.
    return htons(port)



class Socket:
    func __init__(
        sock: usize,
        addr *: const char,
        addrlen: int32
    ) void:
        ; EN : Initializes a Socket wrapper around an operating-system handle.
        ;
        ; ES : Inicializa un envoltorio Socket alrededor de un handle del sistema.
        self._sock = sock
        self._addr = addr
        self._addrlen = addrlen
        self._closed = false

    @unsafe
    func connect() int32:
        ; EN : Connects the owned socket to its target address.
        ;
        ; ES : Conecta el socket propio a su dirección de destino.
        if self._closed:
            return SOCKET_ERROR
        
        if self._sock == INVALID_SOCKET:
            return SOCKET_ERROR
        
        result: int32 = Connect(self._sock, self._addr, self._addrlen)
        return result

    @unsafe
    func send(buf *: const char, len: int32) int32:
        ; EN : Sends data through the owned socket.
        ;
        ; ES : Envía datos a través del socket propio.
        if self._closed:
            return SOCKET_ERROR
        
        if self._sock == INVALID_SOCKET:
            return SOCKET_ERROR

        result: int32 = Send(self._sock, buf, len)

        return result

    @unsafe
    func recv(buf *: char, len: int32) int32:
        ; EN : Receives data from the owned socket into a buffer.
        ;
        ; ES : Recibe datos desde el socket propio en un buffer.
        if self._closed:
            return SOCKET_ERROR
        
        if self._sock == INVALID_SOCKET:
            return SOCKET_ERROR

        result: int32 = Recv(self._sock, buf, len)
        return result

    @unsafe
    func close() int32:
        ; EN : Closes the owned socket descriptor.
        ;
        ; ES : Cierra el descriptor de socket propio.
        if self._closed:
            return 0

        if self._sock == INVALID_SOCKET:
            self._closed = true
            return SOCKET_ERROR
        
        result: int32 = Close(self._sock)
        if result == 0:
            self._closed = true
            self._sock = INVALID_SOCKET
        return result

    @unsafe
    func __deletion__() void:
        ; EN : Closes the owned socket when the object is deleted.
        ;
        ; ES : Cierra el socket propio cuando se destruye el objeto.
        self.close()
        return


private mold NetSockLen:
    wide: usize
    small: int32

; EN: Resolve a hostname and open a connected TCP socket using the native API.
; ES: Resuelve un host y abre un socket TCP conectado con la ABI nativa.
private mold NativeAddrCursor:
    ptr *: ADDRINFO
    numeric: usize

; Enable a listening socket to rebind after previous connections close.
@unsafe
public func ReuseAddress(handle: usize) bool:
    enabled: int32 = 1
    return setsockopt(handle, 65535, 4, $enabled, 4) == 0

@unsafe
public func OpenTcpHost(node *: const char, service *: const char, timeout_ms: int32) usize:
    if timeout_ms < 1:
        return INVALID_SOCKET
    hints: ADDRINFO
    hints.ai_flags = 0
    hints.ai_family = AF_UNSPEC
    hints.ai_socktype = SOCK_STREAM
    hints.ai_protocol = IPPROTO_TCP
    hints.ai_addrlen = 0
    address *: ADDRINFO = Null
    if GetAddrInfo(node, service, $hints, $address) != 0:
        return INVALID_SOCKET
    cursor *: ADDRINFO = address
    cursor_bits: NativeAddrCursor
    cursor_bits.ptr = cursor
    while cursor_bits.numeric != 0:
        handle: usize = Open((cursor).ai_family, (cursor).ai_socktype, (cursor).ai_protocol)
        if handle != INVALID_SOCKET:
            if set_timeout(handle, timeout_ms) == 0:
                if (cursor).ai_addrlen <= 2147483647:
                    size: NetSockLen
                    size.wide = (cursor).ai_addrlen
                    if Connect(handle, (cursor).ai_addr, size.small) == 0:
                        ReleaseAddrInfo(address)
                        return handle
            Close(handle)
        cursor = (cursor).ai_next
        cursor_bits.ptr = cursor
    ReleaseAddrInfo(address)
    return INVALID_SOCKET