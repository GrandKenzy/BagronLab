; EN: Bagron process and scheduler helpers built on Kernel32.
;
; ES: Ayudas de procesos y planificación de Bagron construidas sobre Kernel32.

import {
    ExitProcess,
    GetCurrentProcessId,
    GetLastError,
    SetLastError,
    Sleep,
    SwitchToThread
} from kernel32

extern bagron "process":
    __bagron_argc() int32
    __bagron_arg_copy(index: int32, buffer *: char, capacity: int32) int32

; EN: Terminates the current process through the native Windows ABI.
; STATUS_ILLEGAL_INSTRUCTION preserves the historical trap exit status.
;
; ES: Termina el proceso actual mediante la ABI nativa de Windows.
; STATUS_ILLEGAL_INSTRUCTION conserva el estado de salida histórico de trap.
@unsafe
public func trap() void:
    ; EN: Uses Kernel32 directly; no C or assembler compatibility layer is needed.
    ; ES: Usa Kernel32 directamente; no necesita una capa de compatibilidad C o ASM.
    ExitProcess(3221225501)
    return

; EN: Returns the identifier of the current Windows process.
;
; ES: Devuelve el identificador del proceso actual de Windows.
@unsafe
public func process_id() uint32:
    return GetCurrentProcessId()

; EN: Terminates the current process with the supplied exit code.
;
; ES: Termina el proceso actual con el código de salida indicado.
@unsafe
public func exit_process(code: uint32) void:
    ExitProcess(code)
    return

; EN: Yields the current thread and reports whether another thread was scheduled.
;
; ES: Cede la hebra actual e indica si se planificó otra hebra.
@unsafe
public func yield_thread() bool:
    return SwitchToThread() != 0

; EN: Reads the last-error value associated with the current thread.
;
; ES: Lee el valor de último error asociado con la hebra actual.
@unsafe
public func last_error() uint32:
    return GetLastError()

; EN: Sets the last-error value associated with the current thread.
;
; ES: Establece el valor de último error asociado con la hebra actual.
@unsafe
public func set_last_error(error_code: uint32) void:
    SetLastError(error_code)
    return

; EN : Returns the number of process arguments, including the executable path.
; The value is supplied by Bagron's native process wrapper.
;
; ES : Devuelve el número de argumentos del proceso, incluida la ruta del ejecutable.
; El valor lo proporciona el wrapper nativo de procesos de Bagron.
@unsafe
public func process_arg_count() int32:
    ; EN : Reads argc without depending on the C runtime or a Windows CRT.
    ; ES : Lee argc sin depender del runtime C ni de una CRT de Windows.
    return __bagron_argc()

; EN : Copies one process argument as a NUL-terminated native byte string.
; Index zero is the executable path; invalid indexes return zero.
;
; ES : Copia un argumento del proceso como cadena de bytes terminada en NUL.
; El índice cero es la ruta del ejecutable; los índices inválidos devuelven cero.
@unsafe
public func process_arg_copy(
    index: int32,
    buffer *: char,
    capacity: int32
) int32:
    ; EN : The native wrapper truncates to capacity - 1 and always writes NUL.
    ; ES : El wrapper nativo limita a capacidad - 1 y siempre escribe NUL.
    return __bagron_arg_copy(index, buffer, capacity)
