; 121 golden numeric comparisons. Generated reference values from JavaScript math.
; Each test uses typed double variables to preserve precision of constants.
clause System "auto"
clause Arch "amd"
library math as Math
import { sin, cos, exp, ln, sqrt, cbrt, atan, tanh, abs } from Math

@unsafe
func close(a: double, b: double, tolerance: double) bool:
    difference: double = abs(a - b)
    scale: double = abs(b)
    if scale < 1.0:
        scale = 1.0
    return difference <= tolerance * scale

