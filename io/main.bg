; Library source root for the standard I/O API.
#if OS, "windows"
clause System "windows"
clause Arch "amd"
library windows as Win
library string as String
#elif OS, "linux"
clause System "linux"
clause Arch "amd"
library gnulibrary as Gnu
library string as String
#elif OS, "android"
clause System "android"
clause Arch "aarch64-linux-android35"
library androidlib as Android
library string as String
#else
clause System "auto"
clause Arch "auto"
#end

import { clear_error as IoClearError, last_error as IoLastError } from error
import { arg_count, arg_copy } from args
import { input } from input
import {
    flush,
    print,
    print_bool,
    print_buffer,
    print_char,
    print_chars,
    print_int,
    print_size,
    print_uint,
    println,
    write_buffer,
    write_byte,
    write_chars
} from output
