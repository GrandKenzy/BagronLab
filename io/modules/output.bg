; Standard output, buffering, and formatting for Windows.

private stdout_initialized: bool = false
private stdout_buffer: char[4096]
private stdout_position: usize = 0
private NumericDigits: chain = String.NumericString

#if OS, "windows"
private stdout_handle: HANDLE
#end

@assembler
private func _output_count(value: usize) uint32:
    ; EN : Narrows a native buffer length to the Win32 byte-count ABI.
    ;
    ; ES : Reduce la longitud de un buffer al ABI de conteo de bytes de Win32.
    #assembler "intel"
        mov eax, ecx
    #end
    return asm

@unsafe
private func _write_direct(data *: void, count: usize) void:
    ; EN : Writes bytes directly to the native standard-output endpoint.
    ;
    ; ES : Escribe bytes directamente en el endpoint nativo de salida estándar.
#if OS, "windows"
    if not stdout_initialized:
        stdout_handle = Win.GetStdHandle(Win.STD_OUTPUT_HANDLE)
        stdout_initialized = true
    Win.WriteFile(
        stdout_handle,
        data,
        _output_count(count),
        Null,
        Null
    )
#elif OS, "linux"
    Gnu.write(Gnu.STDOUT, data, count)
#end
    return

@unsafe
private func _flush_stdout() void:
    if stdout_position == 0:
        return
    _write_direct($stdout_buffer[0], stdout_position)
    stdout_position = 0
    return

@unsafe
private func _append_chain(
    text: chain,
    length: Len_t,
    count: usize
) void:
    ; EN : Appends a bounded chain to the buffered stdout stream.
    ;
    ; ES : Agrega una cadena acotada al flujo stdout almacenado.
    if count > length:
        return

    index: usize = 0
    while index < count:
        if stdout_position == 4096:
            _flush_stdout()
        stdout_buffer[stdout_position] = text[index]
        stdout_position += 1
        index += 1
    return

@unsafe
private func _append_chars(
    buffer: char[],
    length: Len_t,
    size: Size_t,
    count: usize
) void:
    ; EN : Appends a bounded character array to the buffered stdout stream.
    ;
    ; ES : Agrega un array de caracteres acotado al flujo stdout almacenado.
    if size != 1 || count > length:
        return

    index: usize = 0
    while index < count:
        if stdout_position == 4096:
            _flush_stdout()
        stdout_buffer[stdout_position] = buffer[index]
        stdout_position += 1
        index += 1
    return

@unsafe
private func _append_chars_at(
    buffer: char[],
    length: Len_t,
    size: Size_t,
    start: usize,
    count: usize
) void:
    ; EN : Appends a bounded character-array slice to buffered stdout.
    ;
    ; ES : Agrega un segmento acotado de caracteres al stdout almacenado.
    if size != 1 || start > length || count > length - start:
        return

    index: usize = 0
    while index < count:
        if stdout_position == 4096:
            _flush_stdout()
        stdout_buffer[stdout_position] = buffer[start + index]
        stdout_position += 1
        index += 1
    return

@unsafe
private inline func _append_line_break() void:
    ; EN : Appends one newline to the buffered stdout stream.
    ;
    ; ES : Agrega un salto de línea al flujo stdout almacenado.
    _append_chain("\n", 1)
    return

@unsafe
public func write_chars(
    buffer: char[],
    length: Len_t,
    size: Size_t,
    count: usize,
    nl: bool
) void:
    ; EN : Writes a bounded character array to buffered stdout.
    ;
    ; ES : Escribe un array de caracteres acotado en stdout almacenado.
    if size != 1:
        return
    if count > length:
        return
    if count > 0:
        _append_chars(buffer, count)
    if nl:
        _append_line_break()
    return

@unsafe
public func print(text: chain, length: Len_t) void:
    ; EN : Appends a NUL-terminated chain without its terminator.
    ;
    ; ES : Agrega una cadena terminada en NUL sin su terminador.
    count: usize = 0
    if length > 0:
        count = length
        count -= 1
    if count > 0:
        _append_chain(text, count)
    return

@unsafe
public inline func println(text: chain, length: Len_t) void:
    ; EN : Prints a chain followed by a newline.
    ;
    ; ES : Imprime una cadena seguida de un salto de línea.
    print(text)
    print("\n")
    return

@unsafe
public inline func flush() void:
    ; EN : Flushes buffered stdout to the native handle.
    ;
    ; ES : Vacía el stdout almacenado hacia el handle nativo.
    _flush_stdout()

@unsafe
public inline func print_char(value: char, nl: bool) void:
    ; EN : Prints one character.
    ;
    ; ES : Imprime un carácter.
    buffer: char[2]
    buffer[0] = value
    buffer[1] = "\0"
    write_chars(buffer, 1, nl)
    return

@unsafe
public inline func print_bool(value: bool, nl: bool) void:
    ; EN : Prints a boolean as true or false.
    ;
    ; ES : Imprime un booleano como true o false.
    if value:
        print("true")
    else:
        print("false")
    if nl:
        _append_line_break()
    return

@unsafe
public func print_chars(
    buffer: char[],
    length: Len_t,
    size: Size_t,
    nl: bool
) void:
    ; EN : Prints a character array up to its first NUL byte.
    ;
    ; ES : Imprime un array de caracteres hasta su primer byte NUL.
    if size != 1:
        return
    count: usize = 0
    while count < length && buffer[count] != 0:
        count += 1
    if count > 0:
        _append_chars(buffer, count)
    if nl:
        _append_line_break()
    return

@unsafe
public func print_buffer(data: buffer[], length: Len_t, nl: bool) void:
    ; EN : Writes a byte buffer as NUL-terminated text.
    ;
    ; ES : Escribe un buffer de bytes como texto terminado en NUL.
    if length == 0:
        return

    staging: byte[4096]
    count: usize = 0
    while count < length && count < 4095 && data[count] != 0:
        staging[count] = data[count]
        count += 1

    _flush_stdout()
    _write_direct($staging[0], count)
    if nl:
        _append_line_break()
    return

@unsafe
public func write_byte(value: byte, nl: bool) void:
    ; EN : Writes one byte directly to stdout, including zero.
    ;
    ; ES : Escribe un byte directamente en stdout, incluido el cero.
    raw: byte[1]
    raw[0] = value
    _flush_stdout()
    _write_direct($raw[0], 1)
    if nl:
        _append_line_break()
    return

@unsafe
private func _print_int64(value: int64) void:
    ; EN : Formats a signed 64-bit value into the output buffer.
    ;
    ; ES : Formatea un valor signed de 64 bits en el buffer de salida.
    buffer: char[32]
    cursor: int64 = value
    digit: int64 = 0
    position: usize = 31
    written: usize = 0
    negative: bool = value < 0

    buffer[position] = "\0"
    if value == 0:
        position -= 1
        buffer[position] = NumericDigits[0]
    elif negative:
        while cursor < 0:
            digit = 0 - (cursor % 10)
            position -= 1
            buffer[position] = NumericDigits[digit]
            cursor /= 10
        position -= 1
        buffer[position] = "-"
    else:
        while cursor > 0:
            digit = cursor % 10
            position -= 1
            buffer[position] = NumericDigits[digit]
            cursor /= 10

    written = 31 - position
    _append_chars_at(buffer, position, written)
    return

@unsafe
private func _print_uint64(value: uint64) void:
    ; EN : Formats an unsigned 64-bit value into the output buffer.
    ;
    ; ES : Formatea un valor unsigned de 64 bits en el buffer de salida.
    buffer: char[32]
    cursor: uint64 = value
    digit: uint64 = 0
    position: usize = 31
    written: usize = 0

    buffer[position] = "\0"
    if value == 0:
        position -= 1
        buffer[position] = NumericDigits[0]
    else:
        while cursor > 0:
            digit = cursor % 10
            position -= 1
            buffer[position] = NumericDigits[digit]
            cursor /= 10

    written = 31 - position
    _append_chars_at(buffer, position, written)
    return

@unsafe
private func _print_usize(value: usize) void:
    ; EN : Formats a target-sized unsigned value into the output buffer.
    ;
    ; ES : Formatea un valor unsigned del tamaño del target en el buffer.
    buffer: char[32]
    cursor: usize = value
    digit: usize = 0
    position: usize = 31
    written: usize = 0

    buffer[position] = "\0"
    if value == 0:
        position -= 1
        buffer[position] = NumericDigits[0]
    else:
        while cursor > 0:
            digit = cursor % 10
            position -= 1
            buffer[position] = NumericDigits[digit]
            cursor /= 10

    written = 31 - position
    _append_chars_at(buffer, position, written)
    return

@unsafe
private func _print_isize(value: isize) void:
    ; EN : Formats a target-sized signed value into the output buffer.
    ;
    ; ES : Formatea un valor signed del tamaño del target en el buffer.
    buffer: char[32]
    cursor: isize = value
    digit: isize = 0
    position: usize = 31
    written: usize = 0
    negative: bool = value < 0

    buffer[position] = "\0"
    if value == 0:
        position -= 1
        buffer[position] = NumericDigits[0]
    elif negative:
        while cursor < 0:
            digit = 0 - (cursor % 10)
            position -= 1
            buffer[position] = NumericDigits[digit]
            cursor /= 10
        position -= 1
        buffer[position] = "-"
    else:
        while cursor > 0:
            digit = cursor % 10
            position -= 1
            buffer[position] = NumericDigits[digit]
            cursor /= 10

    written = 31 - position
    _append_chars_at(buffer, position, written)
    return

@unsafe
private inline func _print_usize_value(value: usize) void:
    ; EN : Prints a target-sized unsigned value.
    ;
    ; ES : Imprime un valor unsigned del tamaño del target.
    _print_usize(value)
    return

@unsafe
public inline func print_int(value: isize, nl: bool) void:
    ; EN : Prints a target-sized signed integer.
    ;
    ; ES : Imprime un entero signed del tamaño del target.
    _print_isize(value)
    if nl:
        _append_line_break()
    return

@unsafe
public inline func print_uint(value: usize, nl: bool) void:
    ; EN : Prints a target-sized unsigned integer.
    ;
    ; ES : Imprime un entero unsigned del tamaño del target.
    _print_usize_value(value)
    if nl:
        _append_line_break()
    return

@unsafe
public inline func print_size(value: usize, value_size: Size_t, nl: bool) void:
    ; EN : Prints a size value when its element width is supported.
    ;
    ; ES : Imprime un valor de tamaño cuando su ancho de elemento es compatible.
    if value_size == 4 || value_size == 8:
        _print_usize_value(value)
    if nl:
        _append_line_break()
    return
