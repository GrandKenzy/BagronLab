; Portable primitives for Bagron buffer[] storage.
; The caller owns the storage. All ranges are checked before access.

; EN: Fills a range with a byte; false for an invalid range.
; ES: Rellena un rango con un byte; false si el rango es invalido.
;
@unsafe
public func fill(data: buffer[], length: Len_t, start: usize, count: usize, value: byte) bool:
    if start > length || count > length - start:
        return false
    i: usize = 0
    while i < count:
        data[start + i] = value
        i += 1
    return true

; EN: Zeroes a bounded range. Not guaranteed to securely erase secrets.
; ES: Limpia a cero un rango. No garantiza borrar secretos.
;
@unsafe
public func zero(data: buffer[], length: Len_t, start: usize, count: usize) bool:
    if start > length || count > length - start:
        return false
    i: usize = 0
    while i < count:
        data[start + i] = 0
        i += 1
    return true

; EN: Copies between disjoint buffers. Overlap is not supported.
; ES: Copia entre buffers distintos. No se admite solapamiento.
;
@unsafe
public func copy(destination: buffer[], destination_length: Len_t, source: buffer[], source_length: Len_t, destination_start: usize, source_start: usize, count: usize) bool:
    if destination_start > destination_length || count > destination_length - destination_start:
        return false
    if source_start > source_length || count > source_length - source_start:
        return false
    i: usize = 0
    while i < count:
        destination[destination_start + i] = source[source_start + i]
        i += 1
    return true

; EN: Moves data within one buffer, including overlapping ranges.
; ES: Mueve bytes dentro de un buffer, incluso con solapamiento.
;
@unsafe
public func move_within(data: buffer[], length: Len_t, destination_start: usize, source_start: usize, count: usize) bool:
    if destination_start > length || count > length - destination_start:
        return false
    if source_start > length || count > length - source_start:
        return false
    if count == 0 || destination_start == source_start:
        return true
    i: usize = 0
    if destination_start > source_start:
        i = count
        while i > 0:
            i -= 1
            data[destination_start + i] = data[source_start + i]
    else:
        i = 0
        while i < count:
            data[destination_start + i] = data[source_start + i]
            i += 1
    return true

; EN: Returns true for identical bounded byte spans.
; ES: Devuelve true si dos segmentos acotados son identicos.
;
@unsafe
public func equal(left: buffer[], left_length: Len_t, right: buffer[], right_length: Len_t, left_start: usize, right_start: usize, count: usize) bool:
    if left_start > left_length || count > left_length - left_start:
        return false
    if right_start > right_length || count > right_length - right_start:
        return false
    i: usize = 0
    while i < count:
        if left[left_start + i] != right[right_start + i]:
            return false
        i += 1
    return true

; EN: Returns the first index at or after start, or length if absent.
; ES: Devuelve el primer indice a partir de start, o length si no existe.
;
@unsafe
public func index_of(data: buffer[], length: Len_t, start: usize, value: byte) usize:
    if start > length:
        return length
    i: usize = start
    while i < length:
        if data[i] == value:
            return i
        i += 1
    return length

; EN: Counts occurrences in a bounded range; 0 for an invalid range.
; ES: Cuenta coincidencias en un rango; devuelve 0 si es invalido.
;
@unsafe
public func count_value(data: buffer[], length: Len_t, start: usize, count: usize, value: byte) usize:
    if start > length || count > length - start:
        return 0
    found: usize = 0
    i: usize = 0
    while i < count:
        if data[start + i] == value:
            found += 1
        i += 1
    return found

; EN: Reverses a bounded buffer range in place.
; ES: Invierte los bytes de un rango sin memoria adicional.
;
@unsafe
public func reverse(data: buffer[], length: Len_t, start: usize, count: usize) bool:
    if start > length || count > length - start:
        return false
    left: usize = 0
    right: usize = count
    while left < right:
        right -= 1
        if left >= right:
            break
        temporary: byte = data[start + left]
        data[start + left] = data[start + right]
        data[start + right] = temporary
        left += 1
    return true
