clause Privacy "public"

import { SIGABRT, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS } from linuxc

; EN: Terminates the current process through the native Linux signal path.
; The raw kill syscall is kept in gnulibrary; callers do not depend on libc.
;
; ES: Termina el proceso actual mediante la ruta nativa de señales de Linux.
; El syscall kill crudo permanece en gnulibrary; los consumidores no dependen de libc.
@unsafe
public func trap() void:
    ; EN: Raises SIGABRT and falls back to exit_group if signal delivery returns.
    ; ES: Eleva SIGABRT y usa exit_group como respaldo si la entrega retorna.
    kill(getpid32(), SIGABRT)
    exit_group(134)

@assembler
func exit(code: int32) Never:
    ; EN: Terminates the calling thread; use exit_group to end the entire process.
    ; The code is already in %edi under System V.
    ;
    ; ES: Termina la hebra llamadora; usa exit_group para finalizar todo el proceso.
    ; El código ya está en %edi según System V.
    #assembler "att"
        movq $60, %rax
        syscall
    #end

@assembler
func exit_group(code: int32) Never:
    ; EN: Terminates every thread in the current process with the given code.
    ;
    ; ES: Termina todas las hebras del proceso actual con el código indicado.
    #assembler "att"
        movq $231, %rax
        syscall
    #end

@assembler
func getpid() int64:
    ; EN: Returns the process identifier.
    ; ES: Retorna el identificador de un proceso
    #assembler "att"
        movq $39, %rax
        syscall
    #end
    return asm

@assembler
func getpid32() uint32:
    ; EN: Returns the process identifier in the native pid_t-sized integer range.
    ; ES: Retorna el identificador del proceso en el rango entero nativo de pid_t.
    #assembler "att"
        movq $39, %rax
        syscall
    #end
    return asm

@assembler
func kill(pid: uint32, signal: uint32) int64:
    ; EN: Sends a signal to a process and returns the raw kernel result.
    ; ES: Envía una señal a un proceso y retorna el resultado crudo del kernel.
    #assembler "att"
        movq $62, %rax
        syscall
    #end
    return asm

@assembler
public func read(fd: int64, buf *: void, size: usize) int64:
    ; EN: Reads up to size bytes from fd into buf.
    ; ES: Lee los bytes de un archivo y los mete en un buffer.
    #assembler "att"
        movq $0, %rax
        syscall
    #end
    return asm

@assembler
public func write(fd: int64, buf *: void, size: usize) int64:
    ; EN: Writes up to size bytes from buf to fd.
    ; ES: Escribe bytes desde un buffer a un archivo.
    #assembler "att"
        movq $1, %rax
        syscall
    #end
    return asm

@assembler
public func close(fd: int64) int64:
    ; EN: Closes a file descriptor.
    ; ES: Cierra el descriptor de un archivo.
    #assembler "att"
        movq $3, %rax
        syscall
    #end
    return asm

@assembler
func getppid() int64:
    ; EN: Returns the parent process identifier.
    ; ES: Retorna el identificador del proceso padre.
    #assembler "att"
        movq $110, %rax
        syscall
    #end
    return asm

@assembler
func getuid() int64:
    ; EN: Returns the real user identifier of the calling process.
    ; ES: Retorna el identificador real de usuario del proceso llamador.
    #assembler "att"
        movq $102, %rax
        syscall
    #end
    return asm

@assembler
func geteuid() int64:
    ; EN: Returns the effective user identifier of the calling process.
    ; ES: Retorna el identificador efectivo de usuario del proceso llamador.
    #assembler "att"
        movq $107, %rax
        syscall
    #end
    return asm

@assembler
func getgid() int64:
    ; EN: Returns the real group identifier of the calling process.
    ; ES: Retorna el identificador real de grupo del proceso llamador.
    #assembler "att"
        movq $104, %rax
        syscall
    #end
    return asm

@assembler
func getegid() int64:
    ; EN: Returns the effective group identifier of the calling process.
    ; ES: Retorna el identificador efectivo de grupo del proceso llamador.
    #assembler "att"
        movq $108, %rax
        syscall
    #end
    return asm

@assembler
func sched_yield() int64:
    ; EN: Voluntarily yields the processor to another runnable thread.
    ; ES: Cede voluntariamente el procesador a otro hilo ejecutable.
    #assembler "att"
        movq $24, %rax
        syscall
    #end
    return asm

@assembler
func mmap(addr *: void, length: uint64, prot: uint32, map_flags: uint32, fd: int64, offset: uint64) int64:
    ; EN: Maps anonymous or file-backed memory and returns the raw kernel result.
    ; The raw int64 preserves negative errno values and pointer bits.
    ; ES: Mapea memoria anónima o respaldada por archivo y retorna el resultado crudo.
    ; El int64 conserva los errno negativos y los bits del puntero.
    #assembler "att"
        movl %ecx, %r10d
        movq $9, %rax
        syscall
    #end
    return asm

@assembler
func munmap(addr *: void, length: uint64) int64:
    ; EN: Unmaps a memory range previously returned by mmap.
    ; ES: Desmapea un rango de memoria obtenido previamente mediante mmap.
    #assembler "att"
        movq $11, %rax
        syscall
    #end
    return asm

@assembler
func clock_gettime(clock_id: int32, timespec *: void) int64:
    ; EN: Writes a clock reading to a caller-provided timespec buffer.
    ; ES: Escribe la lectura de un reloj en un buffer timespec proporcionado por el llamador.
    #assembler "att"
        movq $228, %rax
        syscall
    #end
    return asm

@assembler
func nanosleep(request *: void, remainder *: void) int64:
    ; EN: Suspends execution according to a caller-provided timespec buffer.
    ; ES: Suspende la ejecución según un buffer timespec proporcionado por el llamador.
    #assembler "att"
        movq $35, %rax
        syscall
    #end
    return asm

@assembler
func getrandom(buffer *: void, size: uint64, random_flags: uint32) int64:
    ; EN: Fills a buffer with bytes from the kernel random source.
    ;
    ; ES: Llena un buffer con bytes provenientes de la fuente aleatoria del kernel.
    #assembler "att"
        movq $318, %rax
        syscall
    #end
    return asm

@assembler
func nanosleep_ms(milliseconds: uint32) int64:
    ; EN: Suspends the calling thread for a millisecond interval using nanosleep.
    ; ES: Suspende la hebra llamadora durante un intervalo de milisegundos usando nanosleep.
    #assembler "att"
        subq $24, %rsp
        movl %edi, %eax
        xorl %edx, %edx
        movl $1000, %ecx
        divl %ecx
        movq %rax, (%rsp)
        movl %edx, %eax
        movl $1000000, %ecx
        mull %ecx
        movq %rax, 8(%rsp)
        movq %rsp, %rdi
        xorl %esi, %esi
        movq $35, %rax
        syscall
        addq $24, %rsp
    #end
    return asm

; Typed char-buffer syscalls; no libc dependency.
@assembler
public func read_chars(fd: int64, buf *: char, size: usize) int64:
    #assembler "att"
        movq $0, %rax
        syscall
    #end
    return asm

@assembler
public func write_chars(fd: int64, buf *: const char, size: usize) int64:
    #assembler "att"
        movq $1, %rax
        syscall
    #end
    return asm

; Linux x86_64 virtual-memory helpers for the mmap library.
; Keep kernel syscalls and pointer reinterpretation in gnulibrary.
private mold VirtualMemoryBits:
    word: usize
    wide: uint64
    signed: int64
    pointer *: void

@assembler
func mprotect(addr *: void, length: uint64, prot: uint32) int64:
    #assembler "att"
        movq $10, %rax
        syscall
    #end
    return asm

; EN: Allocates anonymous private read/write pages, returning 0 on failure.
; ES: Reserva paginas anonimas privadas de lectura/escritura; 0 si falla.
@unsafe
public func vm_map_rw(size: usize) usize:
    if size == 0:
        return 0
    count: VirtualMemoryBits
    count.word = size
    result: int64 = mmap(Null, count.wide, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
    if result < 0 && result >= -4095:
        return 0
    bits: VirtualMemoryBits
    bits.signed = result
    return bits.word

; EN: Releases an entire region with its original size.
; ES: Libera una region completa usando el tamano original.
@unsafe
public func vm_unmap(address: usize, size: usize) bool:
    if address == 0 || size == 0:
        return false
    addr: VirtualMemoryBits
    count: VirtualMemoryBits
    addr.word = address
    count.word = size
    return munmap(addr.pointer, count.wide) == 0

; EN: Restricts pages to read-only, or restores read/write.
; ES: Restringe paginas a solo lectura o restaura lectura/escritura.
@unsafe
public func vm_protect(address: usize, size: usize, readonly: bool) bool:
    if address == 0 || size == 0:
        return false
    addr: VirtualMemoryBits
    count: VirtualMemoryBits
    addr.word = address
    count.word = size
    prot: uint32 = PROT_READ | PROT_WRITE
    if readonly:
        prot = PROT_READ
    return mprotect(addr.pointer, count.wide, prot) == 0
