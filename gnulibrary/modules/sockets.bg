clause System "linux"
clause Arch "auto"
clause Privacy "public"

; EN: General socket error indicators.
; ES: Indicadores generales de error de sockets.
public SOCKET_ERROR: const int32 = -1
public INVALID_SOCKET: const usize = 18446744073709551615

; EN: Address families (domain).
; ES: Familias de direcciones (dominio).
public AF_UNSPEC: const int32 = 0
public AF_UNIX: const int32 = 1
public AF_LOCAL: const int32 = 1
public AF_INET: const int32 = 2
public AF_INET6: const int32 = 10

; EN: Socket communication semantics and flags.
; ES: Semánticas de comunicación de sockets y banderas.
public SOCK_STREAM: const int32 = 1
public SOCK_DGRAM: const int32 = 2
public SOCK_RAW: const int32 = 3
public SOCK_NONBLOCK: const int32 = 2048
public SOCK_CLOEXEC: const int32 = 524288

; EN: Standard IP protocols.
; ES: Protocolos IP estándar.
public IPPROTO_IP: const int32 = 0
public IPPROTO_ICMP: const int32 = 1
public IPPROTO_TCP: const int32 = 6
public IPPROTO_UDP: const int32 = 17
public IPPROTO_IPV6: const int32 = 41

; EN: Socket options levels and options.
; ES: Niveles y opciones de sockets.
public SOL_SOCKET: const int32 = 1
public SO_DEBUG: const int32 = 1
public SO_REUSEADDR: const int32 = 2
public SO_TYPE: const int32 = 3
public SO_ERROR: const int32 = 4
public SO_DONTROUTE: const int32 = 5
public SO_BROADCAST: const int32 = 6
public SO_SNDBUF: const int32 = 7
public SO_RCVBUF: const int32 = 8
public SO_KEEPALIVE: const int32 = 9
public SO_OOBINLINE: const int32 = 10
public SO_NO_CHECK: const int32 = 11
public SO_PRIORITY: const int32 = 12
public SO_LINGER: const int32 = 13
public SO_BSDCOMPAT: const int32 = 14
public SO_REUSEPORT: const int32 = 15
public SO_RCVTIMEO: const int32 = 20
public SO_SNDTIMEO: const int32 = 21

; EN: Shutdown reception and transmission control.
; ES: Control de recepción y transmisión al apagar.
public SHUT_RD: const int32 = 0
public SHUT_WR: const int32 = 1
public SHUT_RDWR: const int32 = 2

; EN: Message transmission flags.
; ES: Banderas de transmisión de mensajes.
public MSG_OOB: const int32 = 1
public MSG_PEEK: const int32 = 2
public MSG_DONTROUTE: const int32 = 4
public MSG_DONTWAIT: const int32 = 64
public MSG_WAITALL: const int32 = 256
public MSG_NOSIGNAL: const int32 = 16384


@align(2)
public struct SOCKADDR:
    ; EN: Generic socket address structure (16 bytes).
    ;
    ; ES: Estructura genérica de dirección de socket (16 bytes).
    sa_family: uint16
    sa_data: char[14]


@align(4)
public struct SOCKADDR_IN:
    ; EN: IPv4 socket address structure (16 bytes).
    ;
    ; ES: Estructura de dirección de socket IPv4 (16 bytes).
    sin_family: uint16
    sin_port: uint16
    sin_addr: uint32
    sin_zero: char[8]


@align(8)
public struct TIMEVAL:
    ; EN: Time interval structure representing seconds and microseconds.
    ;
    ; ES: Estructura de intervalo de tiempo que representa segundos y microsegundos.
    tv_sec: int64
    tv_usec: int64


@align(8)
public struct ADDRINFO:
    ; EN: POSIX/Linux addrinfo structure for network consumers.
    ; Linux/POSIX places ai_addr before ai_canonname in the native structure.
    ;
    ; ES: Estructura addrinfo para POSIX/Linux en consumidores de red.
    ; Linux/POSIX coloca ai_addr antes de ai_canonname en la estructura nativa.
    ai_flags: int32
    ai_family: int32
    ai_socktype: int32
    ai_protocol: int32
    ai_addrlen: int32
    ai_addr *: const char
    ai_canonname *: const char
    ai_next *: ADDRINFO


@assembler
public func socket(domain: int32, kind: int32, protocol: int32) usize:
    ; EN: Creates an endpoint for communication and returns a socket handle.
    ; Syscall 41 (sys_socket).
    ;
    ; ES: Crea un endpoint de comunicación y retorna un handle de socket.
    ; Syscall 41 (sys_socket).
    #assembler "att"
        movq $41, %rax
        syscall
    #end
    return asm


@assembler
public func connect(sock: usize, addr *: const void, addrlen: int32) int32:
    ; EN: Initiates a connection on a socket descriptor.
    ; Syscall 42 (sys_connect).
    ;
    ; ES: Inicia una conexión en un descriptor de socket.
    ; Syscall 42 (sys_connect).
    #assembler "att"
        movq $42, %rax
        syscall
    #end
    return asm


@assembler
public func accept(sock: usize, addr *: void, addrlen *: int32) usize:
    ; EN: Accepts a connection on a listening socket descriptor.
    ; Syscall 43 (sys_accept).
    ;
    ; ES: Acepta una conexión en un descriptor de socket en escucha.
    ; Syscall 43 (sys_accept).
    #assembler "att"
        movq $43, %rax
        syscall
    #end
    return asm


@assembler
public func accept4(sock: usize, addr *: void, addrlen *: int32, flags_: uint32) usize:
    ; EN: Accepts a connection with explicit non-blocking or close-on-exec flags.
    ; Syscall 288 (sys_accept4). The 4th argument moves from %ecx to %r10d.
    ;
    ; ES: Acepta una conexión con flags explícitos de non-blocking o close-on-exec.
    ; Syscall 288 (sys_accept4). El 4to argumento pasa de %ecx a %r10d.
    #assembler "att"
        movl %ecx, %r10d
        movq $288, %rax
        syscall
    #end
    return asm


@assembler
public func bind(sock: usize, addr *: void, addrlen: int32) int32:
    ; EN: Binds a unique local address to a socket descriptor.
    ; Syscall 49 (sys_bind).
    ;
    ; ES: Asocia una dirección local única a un descriptor de socket.
    ; Syscall 49 (sys_bind).
    #assembler "att"
        movq $49, %rax
        syscall
    #end
    return asm


@assembler
public func listen(sock: usize, backlog: int32) int32:
    ; EN: Marks the socket descriptor as passive, ready to accept connections.
    ; Syscall 50 (sys_listen).
    ;
    ; ES: Marca el descriptor de socket como pasivo, listo para aceptar conexiones.
    ; Syscall 50 (sys_listen).
    #assembler "att"
        movq $50, %rax
        syscall
    #end
    return asm


@assembler
public func sendto(sock: usize, buf *: const void, len: int32, flags_: int32, dest_addr *: const void, addrlen: int32) int32:
    ; EN: Sends a message on a socket to a specific address.
    ; Syscall 44 (sys_sendto). The 4th argument moves from %ecx to %r10d.
    ;
    ; ES: Envía un mensaje a través de un socket hacia una dirección específica.
    ; Syscall 44 (sys_sendto). El 4to argumento pasa de %ecx a %r10d.
    #assembler "att"
        movl %ecx, %r10d
        movq $44, %rax
        syscall
    #end
    return asm


@assembler
public func recvfrom(sock: usize, buf *: void, len: int32, flags_: int32, src_addr *: void, addrlen *: int32) int32:
    ; EN: Receives a message from a socket, optionally capturing the sender address.
    ; Syscall 45 (sys_recvfrom). The 4th argument moves from %ecx to %r10d.
    ;
    ; ES: Recibe un mensaje desde un socket, capturando opcionalmente la dirección remitente.
    ; Syscall 45 (sys_recvfrom). El 4to argumento pasa de %ecx a %r10d.
    #assembler "att"
        movl %ecx, %r10d
        movq $45, %rax
        syscall
    #end
    return asm


@assembler
public func send(sock: usize, buf *: const void, len: int32, flags_: int32) int32:
    ; EN: Transmits a message on a connected socket descriptor.
    ; Syscall 44 (sys_sendto with null destination).
    ;
    ; ES: Transmite un mensaje en un descriptor de socket conectado.
    ; Syscall 44 (sys_sendto con destino nulo).
    #assembler "att"
        movl %ecx, %r10d
        xorq %r8, %r8
        xorq %r9, %r9
        movq $44, %rax
        syscall
    #end
    return asm


@assembler
public func recv(sock: usize, buf *: void, len: int32, flags_: int32) int32:
    ; EN: Receives data from a connected socket descriptor into a buffer.
    ; Syscall 45 (sys_recvfrom with null source).
    ;
    ; ES: Recibe datos desde un descriptor de socket conectado en un buffer.
    ; Syscall 45 (sys_recvfrom con origen nulo).
    #assembler "att"
        movl %ecx, %r10d
        xorq %r8, %r8
        xorq %r9, %r9
        movq $45, %rax
        syscall
    #end
    return asm


@assembler
public func shutdown(sock: usize, how: int32) int32:
    ; EN: Shuts down part of a full-duplex connection on a socket.
    ; Syscall 48 (sys_shutdown).
    ;
    ; ES: Deshabilita parte de una conexión full-duplex en un socket.
    ; Syscall 48 (sys_shutdown).
    #assembler "att"
        movq $48, %rax
        syscall
    #end
    return asm


@assembler
public func getsockname(sock: usize, addr *: void, addrlen *: int32) int32:
    ; EN: Retrieves the current local address associated with a socket.
    ; Syscall 51 (sys_getsockname).
    ;
    ; ES: Obtiene la dirección local actual asociada a un socket.
    ; Syscall 51 (sys_getsockname).
    #assembler "att"
        movq $51, %rax
        syscall
    #end
    return asm


@assembler
public func getpeername(sock: usize, addr *: void, addrlen *: int32) int32:
    ; EN: Retrieves the remote address of the peer connected to a socket.
    ; Syscall 52 (sys_getpeername).
    ;
    ; ES: Obtiene la dirección remota del par conectado a un socket.
    ; Syscall 52 (sys_getpeername).
    #assembler "att"
        movq $52, %rax
        syscall
    #end
    return asm


@assembler
public func socketpair(domain: int32, kind: int32, protocol: int32, sv *: int32) int32:
    ; EN: Creates an unnamed pair of connected sockets in the specified domain.
    ; Syscall 53 (sys_socketpair). The 4th argument moves from %rcx to %r10.
    ;
    ; ES: Crea un par no nombrado de sockets conectados en el dominio especificado.
    ; Syscall 53 (sys_socketpair). El 4to argumento pasa de %ecx a %r10.
    #assembler "att"
        movq %rcx, %r10
        movq $53, %rax
        syscall
    #end
    return asm


@assembler
public func setsockopt(sock: usize, level: int32, option: int32, value *: void, value_length: int32) int32:
    ; EN: Sets options associated with a socket descriptor.
    ; Syscall 54 (sys_setsockopt). The 4th argument moves from %rcx to %r10.
    ;
    ; ES: Establece opciones asociadas a un descriptor de socket.
    ; Syscall 54 (sys_setsockopt). El 4to argumento pasa de %ecx a %r10.
    #assembler "att"
        movq %rcx, %r10
        movq $54, %rax
        syscall
    #end
    return asm


@assembler
public func getsockopt(sock: usize, level: int32, option: int32, value *: void, value_length *: int32) int32:
    ; EN: Retrieves options associated with a socket descriptor.
    ; Syscall 55 (sys_getsockopt). The 4th argument moves from %rcx to %r10.
    ;
    ; ES: Obtiene opciones asociadas a un descriptor de socket.
    ; Syscall 55 (sys_getsockopt). El 4to argumento pasa de %ecx a %r10.
    #assembler "att"
        movq %rcx, %r10
        movq $55, %rax
        syscall
    #end
    return asm


@assembler
public func close_socket(sock: usize) int32:
    ; EN: Closes a socket file descriptor via sys_close.
    ; Syscall 3 (sys_close).
    ;
    ; ES: Cierra un descriptor de archivo de socket mediante sys_close.
    ; Syscall 3 (sys_close).
    #assembler "att"
        movq $3, %rax
        syscall
    #end
    return asm


@assembler
public func htons(port: int32) uint16:
    ; EN: Converts a 16-bit integer from host byte order to network byte order.
    ; ES: Convierte un entero de 16 bits del orden de bytes del host al de la red.
    #assembler "att"
        movl %edi, %eax
        rolw $8, %ax
    #end
    return asm


@assembler
public func ntohs(port: uint16) int32:
    ; EN: Converts a 16-bit integer from network byte order to host byte order.
    ; ES: Convierte un entero de 16 bits del orden de bytes de red al del host.
    #assembler "att"
        movzwl %di, %eax
        rolw $8, %ax
    #end
    return asm


extern c "c":
    getaddrinfo(node *: const char, service *: const char, hints *: ADDRINFO, result **: ADDRINFO) int32
    freeaddrinfo(result *: ADDRINFO) void


@unsafe
public inline func Open(family: int32, kind: int32, protocol: int32) usize:
    ; EN : Creates a native socket descriptor using Linux kernel syscalls.
    ; Returns INVALID_SOCKET on failure.
    ;
    ; ES : Crea un descriptor de socket nativo mediante llamadas al kernel de Linux.
    ; Devuelve INVALID_SOCKET en caso de error.
    return socket(family, kind, protocol)


@unsafe
public inline func Connect(handle: usize, address *: const char, length: int32) int32:
    ; EN : Establishes a connection to a specified socket address.
    ; Returns 0 on success, or SOCKET_ERROR on failure.
    ;
    ; ES : Establece una conexión a una dirección de socket especificada.
    ; Devuelve 0 en caso de éxito, o SOCKET_ERROR en caso de error.
    return connect(handle, address, length)


@unsafe
public inline func Bind(handle: usize, address *: void, length: int32) int32:
    ; EN : Associates a local address with a socket descriptor.
    ; Returns 0 on success, or SOCKET_ERROR on failure.
    ;
    ; ES : Asocia una dirección local a un descriptor de socket.
    ; Devuelve 0 en caso de éxito, o SOCKET_ERROR en caso de error.
    return bind(handle, address, length)


@unsafe
public inline func Listen(handle: usize, backlog: int32) int32:
    ; EN : Places a socket in a state listening for incoming connections.
    ; Returns 0 on success, or SOCKET_ERROR on failure.
    ;
    ; ES : Coloca un socket en estado de escucha para conexiones entrantes.
    ; Devuelve 0 en caso de éxito, o SOCKET_ERROR en caso de error.
    return listen(handle, backlog)


@unsafe
public inline func Accept(handle: usize, address *: void, length *: int32) usize:
    ; EN : Accepts an incoming connection request on a listening socket.
    ; Returns the new socket descriptor or INVALID_SOCKET on error.
    ;
    ; ES : Acepta una solicitud de conexión entrante en un socket en escucha.
    ; Retorna el nuevo descriptor de socket o INVALID_SOCKET en caso de error.
    return accept(handle, address, length)


@unsafe
public func set_timeout(handle: usize, timeout_ms: int32) int32:
    ; EN : Configures send and receive timeouts on a socket in milliseconds.
    ; Returns 0 on success, or -1 on invalid parameter or socket error.
    ;
    ; ES : Configura tiempos de espera de envío y recepción en milisegundos.
    ; Devuelve 0 en caso de éxito, o -1 en caso de parámetro inválido o error.
    if timeout_ms < 1:
        return -1
    
    tv: TIMEVAL
    sec: int32 = timeout_ms / 1000
    usec: int32 = (timeout_ms % 1000) * 1000
    tv.tv_sec = sec
    tv.tv_usec = usec
    
    receive_result: int32 = setsockopt(handle, SOL_SOCKET, SO_RCVTIMEO, $tv, 16)
    send_result: int32 = setsockopt(handle, SOL_SOCKET, SO_SNDTIMEO, $tv, 16)
    if receive_result != 0 || send_result != 0:
        return -1
    return 0


@unsafe
public inline func Send(handle: usize, buffer *: const char, length: int32) int32:
    ; EN : Sends data on a connected socket descriptor with MSG_NOSIGNAL.
    ; Returns the number of bytes sent, or SOCKET_ERROR on failure.
    ;
    ; ES : Envía datos a través de un descriptor de socket conectado con MSG_NOSIGNAL.
    ; Devuelve el número de bytes enviados, o SOCKET_ERROR en caso de error.
    return send(handle, buffer, length, MSG_NOSIGNAL)


@unsafe
public inline func Recv(handle: usize, buffer *: char, length: int32) int32:
    ; EN : Receives data from a connected socket descriptor into a buffer.
    ; Returns the number of bytes received, 0 on disconnect, or SOCKET_ERROR.
    ;
    ; ES : Recibe datos desde un socket conectado en un buffer.
    ; Devuelve el número de bytes recibidos, 0 al desconectar, o SOCKET_ERROR.
    return recv(handle, buffer, length, 0)


@unsafe
public inline func Close(handle: usize) int32:
    ; EN : Closes an open socket descriptor via sys_close.
    ; Returns 0 on success, or SOCKET_ERROR on failure.
    ;
    ; ES : Cierra un descriptor de socket abierto mediante sys_close.
    ; Devuelve 0 en caso de éxito, o SOCKET_ERROR en caso de error.
    return close_socket(handle)


@unsafe
public inline func GetAddrInfo(node *: const char, service *: const char, hints *: ADDRINFO, result **: ADDRINFO) int32:
    ; EN : Resolves hostnames and service port names into address structures via POSIX resolver.
    ;
    ; ES : Resuelve nombres de host y servicio a estructuras de direcciones mediante el resolver POSIX.
    return getaddrinfo(node, service, hints, result)


@unsafe
public inline func ReleaseAddrInfo(result *: ADDRINFO) void:
    ; EN : Frees address structures allocated dynamically by GetAddrInfo.
    ;
    ; ES : Libera estructuras de direcciones asignadas dinámicamente por GetAddrInfo.
    freeaddrinfo(result)


@unsafe
public inline func Startup() int32:
    ; EN : Compatibility no-op for platforms requiring network subsystem initialization.
    ; Returns 0 on Linux.
    ;
    ; ES : Operación vacía de compatibilidad para plataformas que requieren inicialización.
    ; Devuelve 0 en Linux.
    return 0


@unsafe
public inline func Cleanup() int32:
    ; EN : Compatibility no-op for network subsystem cleanup.
    ; Returns 0 on Linux.
    ;
    ; ES : Operación vacía de compatibilidad para finalización del subsistema de red.
    ; Devuelve 0 en Linux.
    return 0


@unsafe
public inline func NetworkPort(port: int32) uint16:
    ; EN : Converts a 16-bit port number from host byte order to network byte order.
    ;
    ; ES : Convierte un número de puerto de 16 bits de orden de host a orden de red.
    return htons(port)


@unsafe
public inline func HostPort(port: uint16) int32:
    ; EN : Converts a 16-bit port number from network byte order to host byte order.
    ;
    ; ES : Convierte un número de puerto de 16 bits de orden de red a orden de host.
    return ntohs(port)


public class Socket:
    func __init__(sock: usize, addr *: const char, addrlen: int32) void:
        ; EN : Initializes a Socket wrapper around an operating-system handle.
        ;
        ; ES : Inicializa un envoltorio Socket alrededor de un handle del sistema.
        self._sock = sock
        self._addr = addr
        self._addrlen = addrlen
        self._closed = false

    @unsafe
    func connect() int32:
        ; EN : Connects the owned socket to its target address.
        ;
        ; ES : Conecta el socket propio a su dirección de destino.
        if self._closed:
            return SOCKET_ERROR
        
        if self._sock == INVALID_SOCKET:
            return SOCKET_ERROR
        
        result: int32 = Connect(self._sock, self._addr, self._addrlen)
        return result

    @unsafe
    func send(buf *: const char, len: int32) int32:
        ; EN : Sends data through the owned socket.
        ;
        ; ES : Envía datos a través del socket propio.
        if self._closed:
            return SOCKET_ERROR
        
        if self._sock == INVALID_SOCKET:
            return SOCKET_ERROR

        result: int32 = Send(self._sock, buf, len)
        return result

    @unsafe
    func recv(buf *: char, len: int32) int32:
        ; EN : Receives data from the owned socket into a buffer.
        ;
        ; ES : Recibe datos desde el socket propio en un buffer.
        if self._closed:
            return SOCKET_ERROR
        
        if self._sock == INVALID_SOCKET:
            return SOCKET_ERROR

        result: int32 = Recv(self._sock, buf, len)
        return result

    @unsafe
    func close() int32:
        ; EN : Closes the owned socket descriptor.
        ;
        ; ES : Cierra el descriptor de socket propio.
        if self._closed:
            return 0

        if self._sock == INVALID_SOCKET:
            self._closed = true
            return SOCKET_ERROR
        
        result: int32 = Close(self._sock)
        self._closed = true
        self._sock = 0
        return result

    @unsafe
    func __deletion__() void:
        ; EN : Closes the owned socket when the object is deleted.
        ;
        ; ES : Cierra el socket propio cuando se destruye el objeto.
        self.close()
        return
