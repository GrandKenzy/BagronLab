; Linux constants shared by gnulibrary modules and consumers.
clause Privacy "public"

; File descriptors
STDIN: const int32 = 0
STDOUT: const int32 = 1
STDERR: const int32 = 2

; Directory-relative operations
AT_FDCWD: const int32 = -100
AT_SYMLINK_NOFOLLOW: const uint32 = 256
AT_REMOVEDIR: const uint32 = 512
AT_SYMLINK_FOLLOW: const uint32 = 1024
AT_EMPTY_PATH: const uint32 = 4096

; Open flags
O_RDONLY: const uint32 = 0
O_WRONLY: const uint32 = 1
O_RDWR: const uint32 = 2
O_CREAT: const uint32 = 64
O_EXCL: const uint32 = 128
O_NOCTTY: const uint32 = 256
O_TRUNC: const uint32 = 512
O_APPEND: const uint32 = 1024
O_NONBLOCK: const uint32 = 2048
O_DSYNC: const uint32 = 4096
O_DIRECT: const uint32 = 16384
O_DIRECTORY: const uint32 = 65536
O_NOFOLLOW: const uint32 = 131072
O_CLOEXEC: const uint32 = 524288
O_PATH: const uint32 = 2097152

; File offsets
SEEK_SET: const int32 = 0
SEEK_CUR: const int32 = 1
SEEK_END: const int32 = 2
SEEK_DATA: const int32 = 3
SEEK_HOLE: const int32 = 4

; File permission bits
S_IRUSR: const uint32 = 256
S_IWUSR: const uint32 = 128
S_IXUSR: const uint32 = 64
S_IRGRP: const uint32 = 32
S_IWGRP: const uint32 = 16
S_IXGRP: const uint32 = 8
S_IROTH: const uint32 = 4
S_IWOTH: const uint32 = 2
S_IXOTH: const uint32 = 1
MODE_USER_READ_WRITE: const uint32 = 420
MODE_USER_READ_WRITE_EXEC: const uint32 = 493

; mmap protection and mapping flags
PROT_NONE: const uint32 = 0
PROT_READ: const uint32 = 1
PROT_WRITE: const uint32 = 2
PROT_EXEC: const uint32 = 4
MAP_SHARED: const uint32 = 1
MAP_PRIVATE: const uint32 = 2
MAP_FIXED: const uint32 = 16
MAP_ANONYMOUS: const uint32 = 32
MAP_GROWSDOWN: const uint32 = 256
MAP_NORESERVE: const uint32 = 16384
MAP_POPULATE: const uint32 = 32768
MAP_STACK: const uint32 = 131072

; renameat2 flags
RENAME_NOREPLACE: const uint32 = 1
RENAME_EXCHANGE: const uint32 = 2
RENAME_WHITEOUT: const uint32 = 4

; clock IDs
CLOCK_REALTIME: const int32 = 0
CLOCK_MONOTONIC: const int32 = 1
CLOCK_PROCESS_CPUTIME_ID: const int32 = 2
CLOCK_THREAD_CPUTIME_ID: const int32 = 3
CLOCK_MONOTONIC_RAW: const int32 = 4
CLOCK_REALTIME_COARSE: const int32 = 5
CLOCK_MONOTONIC_COARSE: const int32 = 6
CLOCK_BOOTTIME: const int32 = 7

; getrandom flags
GRND_NONBLOCK: const uint32 = 1
GRND_RANDOM: const uint32 = 2
GRND_INSECURE: const uint32 = 4

; Signal numbers used by low-level process control.
SIGTRAP: const uint32 = 5
SIGABRT: const uint32 = 6
