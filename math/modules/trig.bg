import { PI, TAU } from consts
import { trunc } from round

#if ARCHB, "64"
public func sin(value: double) double:
    ; EN : Returns the sine of an angle expressed in radians.
    ; Reduces the period with TAU and evaluates a Taylor series near zero.
    ;
    ; ES : Devuelve el seno de un angulo expresado en radianes.
    ; Reduce el periodo con TAU y evalua una serie de Taylor cerca de cero.
    turns: double = trunc(value / TAU)
    reduced: double = value - turns * TAU
    if reduced > PI:
        reduced = reduced - TAU
    if reduced < 0.0 - PI:
        reduced = reduced + TAU

    square: double = reduced * reduced
    term: double = reduced
    series: double = reduced
    denominator: double = 1.0
    iteration: uint32 = 0
    while iteration < 16:
        denominator = denominator + 1.0
        term = 0.0 - term * square / (denominator * (denominator + 1.0))
        series = series + term
        denominator = denominator + 1.0
        iteration = iteration + 1

    return series

public func cos(value: double) double:
    ; EN : Returns the cosine of an angle expressed in radians.
    ; Reduces the period with TAU and evaluates a Taylor series near zero.
    ;
    ; ES : Devuelve el coseno de un angulo expresado en radianes.
    ; Reduce el periodo con TAU y evalua una serie de Taylor cerca de cero.
    turns: double = trunc(value / TAU)
    reduced: double = value - turns * TAU
    if reduced > PI:
        reduced = reduced - TAU
    if reduced < 0.0 - PI:
        reduced = reduced + TAU

    square: double = reduced * reduced
    term: double = 1.0
    series: double = 1.0
    denominator: double = 0.0
    iteration: uint32 = 0
    while iteration < 16:
        denominator = denominator + 1.0
        term = 0.0 - term * square / (denominator * (denominator + 1.0))
        series = series + term
        denominator = denominator + 1.0
        iteration = iteration + 1

    return series

public func tan(value: double) double:
    ; EN : Returns the tangent of an angle expressed in radians.
    ; Computes sine and cosine with the same range-reduced angle.
    ;
    ; ES : Devuelve la tangente de un angulo expresado en radianes.
    ; Calcula seno y coseno usando el mismo angulo reducido.
    return sin(value) / cos(value)

#elif ARCHB, "32"
public func sin(value: float) float:
    ; EN : Returns the sine of a 32-bit floating-point angle in radians.
    ; Reduces the period with TAU and evaluates a Taylor series near zero.
    ;
    ; ES : Devuelve el seno de un angulo float de 32 bits en radianes.
    ; Reduce el periodo con TAU y evalua una serie de Taylor cerca de cero.
    turns: float = trunc(value / TAU)
    reduced: float = value - turns * TAU
    if reduced > PI:
        reduced = reduced - TAU
    if reduced < 0.0 - PI:
        reduced = reduced + TAU

    square: float = reduced * reduced
    term: float = reduced
    series: float = reduced
    denominator: float = 1.0
    iteration: uint32 = 0
    while iteration < 8:
        denominator = denominator + 1.0
        term = 0.0 - term * square / (denominator * (denominator + 1.0))
        series = series + term
        denominator = denominator + 1.0
        iteration = iteration + 1

    return series

public func cos(value: float) float:
    ; EN : Returns the cosine of a 32-bit floating-point angle in radians.
    ; Reduces the period with TAU and evaluates a Taylor series near zero.
    ;
    ; ES : Devuelve el coseno de un angulo float de 32 bits en radianes.
    ; Reduce el periodo con TAU y evalua una serie de Taylor cerca de cero.
    turns: float = trunc(value / TAU)
    reduced: float = value - turns * TAU
    if reduced > PI:
        reduced = reduced - TAU
    if reduced < 0.0 - PI:
        reduced = reduced + TAU

    square: float = reduced * reduced
    term: float = 1.0
    series: float = 1.0
    denominator: float = 0.0
    iteration: uint32 = 0
    while iteration < 8:
        denominator = denominator + 1.0
        term = 0.0 - term * square / (denominator * (denominator + 1.0))
        series = series + term
        denominator = denominator + 1.0
        iteration = iteration + 1

    return series

public func tan(value: float) float:
    ; EN : Returns the tangent of a 32-bit floating-point angle in radians.
    ; Computes sine and cosine with the same range-reduced angle.
    ;
    ; ES : Devuelve la tangente de un angulo float de 32 bits en radianes.
    ; Calcula seno y coseno usando el mismo angulo reducido.
    return sin(value) / cos(value)

#else


#end
