
import { LN2, LN10 } from consts

#if ARCHB, "64"
public func exp(value: double) double:
    ; EN : Returns the natural exponential of a double value.
    ; Uses range reduction by ln(2) and a Taylor series on the reduced value.
    ;
    ; ES : Devuelve la exponencial natural de un valor double.
    ; Usa reduccion de rango por ln(2) y una serie de Taylor sobre el valor reducido.
    if value == 0.0:
        return 1.0

    scale: double = 1.0
    reduced: double = value
    steps: uint32 = 0
    while reduced > LN2 && steps < 2048:
        reduced = reduced - LN2
        scale = scale * 2.0
        steps = steps + 1
    while reduced < 0.0 - LN2 && steps < 2048:
        reduced = reduced + LN2
        scale = scale / 2.0
        steps = steps + 1

    term: double = 1.0
    series: double = 1.0
    denominator: double = 0.0
    iteration: uint32 = 0
    while iteration < 32:
        denominator = denominator + 1.0
        term = term * reduced / denominator
        series = series + term
        iteration = iteration + 1

    return scale * series

public func ln(value: double) double:
    ; EN : Returns the natural logarithm of a positive double value.
    ; Non-positive inputs return zero; the result uses a range-reduced series.
    ;
    ; ES : Devuelve el logaritmo natural de un valor double positivo.
    ; Las entradas no positivas devuelven cero; usa una serie con rango reducido.
    if value != value:
        return value
    if value <= 0.0:
        return 0.0
    if value == value * 2.0:
        return value

    normalized: double = value
    exponent_term: double = 0.0
    steps: uint32 = 0
    while normalized >= 2.0 && steps < 2048:
        normalized = normalized / 2.0
        exponent_term = exponent_term + LN2
        steps = steps + 1
    while normalized < 1.0 && steps < 2048:
        normalized = normalized * 2.0
        exponent_term = exponent_term - LN2
        steps = steps + 1

    z: double = (normalized - 1.0) / (normalized + 1.0)
    z_squared: double = z * z
    term: double = z
    series: double = z
    denominator: double = 1.0
    iteration: uint32 = 0
    while iteration < 32:
        term = term * z_squared
        denominator = denominator + 2.0
        series = series + term / denominator
        iteration = iteration + 1

    return 2.0 * series + exponent_term

public func log10(value: double) double:
    ; EN : Returns the base-10 logarithm of a positive double value.
    ; Non-positive inputs return zero through the ln contract.
    ;
    ; ES : Devuelve el logaritmo en base 10 de un valor double positivo.
    ; Las entradas no positivas devuelven cero mediante el contrato de ln.
    return ln(value) / LN10

#elif ARCHB, "32"
public func exp(value: float) float:
    ; EN : Returns the natural exponential of a 32-bit float.
    ; Uses range reduction by ln(2) and a Taylor series on the reduced value.
    ;
    ; ES : Devuelve la exponencial natural de un float de 32 bits.
    ; Usa reduccion de rango por ln(2) y una serie de Taylor sobre el valor reducido.
    if value == 0.0:
        return 1.0

    scale: float = 1.0
    reduced: float = value
    steps: uint32 = 0
    while reduced > LN2 && steps < 256:
        reduced = reduced - LN2
        scale = scale * 2.0
        steps = steps + 1
    while reduced < 0.0 - LN2 && steps < 256:
        reduced = reduced + LN2
        scale = scale / 2.0
        steps = steps + 1

    term: float = 1.0
    series: float = 1.0
    denominator: float = 0.0
    iteration: uint32 = 0
    while iteration < 16:
        denominator = denominator + 1.0
        term = term * reduced / denominator
        series = series + term
        iteration = iteration + 1

    return scale * series

public func ln(value: float) float:
    ; EN : Returns the natural logarithm of a positive 32-bit float.
    ; Non-positive inputs return zero; the result uses a range-reduced series.
    ;
    ; ES : Devuelve el logaritmo natural de un float de 32 bits positivo.
    ; Las entradas no positivas devuelven cero; usa una serie con rango reducido.
    if value != value:
        return value
    if value <= 0.0:
        return 0.0
    if value == value * 2.0:
        return value

    normalized: float = value
    exponent_term: float = 0.0
    steps: uint32 = 0
    while normalized >= 2.0 && steps < 256:
        normalized = normalized / 2.0
        exponent_term = exponent_term + LN2
        steps = steps + 1
    while normalized < 1.0 && steps < 256:
        normalized = normalized * 2.0
        exponent_term = exponent_term - LN2
        steps = steps + 1

    z: float = (normalized - 1.0) / (normalized + 1.0)
    z_squared: float = z * z
    term: float = z
    series: float = z
    denominator: float = 1.0
    iteration: uint32 = 0
    while iteration < 16:
        term = term * z_squared
        denominator = denominator + 2.0
        series = series + term / denominator
        iteration = iteration + 1

    return 2.0 * series + exponent_term

public func log10(value: float) float:
    ; EN : Returns the base-10 logarithm of a positive 32-bit float.
    ; Non-positive inputs return zero through the ln contract.
    ;
    ; ES : Devuelve el logaritmo en base 10 de un float de 32 bits positivo.
    ; Las entradas no positivas devuelven cero mediante el contrato de ln.
    return ln(value) / LN10

#else


#end
