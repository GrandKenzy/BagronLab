    i: usize = 0
    while i < length:
        corrected: float = data[i] - compensation
        next_sum: float = total + corrected
        compensation = (next_sum - total) - corrected
        total = next_sum
        count += 1.0
        i += 1
    (result) = total / count
    return true

; EN: Welford's stable population variance (divide by n).
; ES: Varianza poblacional numericamente estable.
@unsafe
