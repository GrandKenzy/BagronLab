; EN: Returns both extrema; does not alter outputs for empty arrays.
; ES: Devuelve minimo y maximo. False si esta vacio.
@unsafe
public func stats_minmax(data: float[], length: Len_t, element_size: Size_t, minimum *: float, maximum *: float) bool:
    if element_size != 4 || length == 0:
        return false
    low: float = data[0]
    high: float = data[0]
