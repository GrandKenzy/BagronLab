; Stable statistics on caller-owned floating-point arrays.
; No allocation. Empty samples and invalid element sizes return false.

#if ARCHB, "64"
; EN: Computes the arithmetic mean using compensated summation.
; ES: Calcula la media mediante suma compensada.
@unsafe
public func stats_mean(data: double[], length: Len_t, element_size: Size_t, result *: double) bool:
    if element_size != 8 || length == 0:
        return false
    total: double = 0.0
    compensation: double = 0.0
    count: double = 0.0
    i: usize = 0
    while i < length:
        corrected: double = data[i] - compensation
        next_sum: double = total + corrected
        compensation = (next_sum - total) - corrected
        total = next_sum
        count += 1.0
        i += 1
    (result) = total / count
    return true

; EN: Welford's stable population variance (divide by n).
; ES: Varianza poblacional numericamente estable.
@unsafe
public func stats_variance(data: double[], length: Len_t, element_size: Size_t, result *: double) bool:
    if element_size != 8 || length == 0:
        return false
    mean: double = 0.0
    m2: double = 0.0
    count: double = 0.0
    i: usize = 0
    while i < length:
        count += 1.0
        delta: double = data[i] - mean
        mean += delta / count
        delta2: double = data[i] - mean
        m2 += delta * delta2
        i += 1
    (result) = m2 / count
    return true

; EN: Welford's sample variance (unbiased, divide by n-1).
; ES: Varianza muestral (divide entre n-1).
@unsafe
public func stats_sample_variance(data: double[], length: Len_t, element_size: Size_t, result *: double) bool:
    if element_size != 8 || length < 2:
        return false
    mean: double = 0.0
    m2: double = 0.0
    count: double = 0.0
    i: usize = 0
    while i < length:
        count += 1.0
        delta: double = data[i] - mean
        mean += delta / count
        delta2: double = data[i] - mean
        m2 += delta * delta2
        i += 1
    (result) = m2 / (count - 1.0)
    return true

; EN: Returns both extrema; does not alter outputs for empty arrays.
; ES: Devuelve minimo y maximo. False si esta vacio.
@unsafe
public func stats_minmax(data: double[], length: Len_t, element_size: Size_t, minimum *: double, maximum *: double) bool:
    if element_size != 8 || length == 0:
        return false
    low: double = data[0]
    high: double = data[0]
    i: usize = 1
    while i < length:
        if data[i] < low:
            low = data[i]
        if data[i] > high:
            high = data[i]
        i += 1
    (minimum) = low
    (maximum) = high
    return true

#elif ARCHB, "32"
; EN: Computes the arithmetic mean using compensated summation.
; ES: Calcula la media mediante suma compensada.
@unsafe
public func stats_mean(data: float[], length: Len_t, element_size: Size_t, result *: float) bool:
    if element_size != 4 || length == 0:
        return false
    total: float = 0.0
    compensation: float = 0.0
