mold OctetView:
    raw: byte
    numeric: uint8

public struct SHA256Digest:
    word0: uint32
    word1: uint32
    word2: uint32
    word3: uint32
    word4: uint32
    word5: uint32
    word6: uint32
    word7: uint32

func sha256_rotr(value: uint32, bits: uint32) uint32:
    ; EN : Rotates a 32-bit word to the right by a constant-sized amount.
    ;
    ; ES : Rota una palabra de 32 bits hacia la derecha.
    return (value >> bits) | (value << (32 - bits))

func sha256_ch(x: uint32, y: uint32, z: uint32) uint32:
    ; EN : Selects bits from y or z according to x.
    ;
    ; ES : Selecciona bits de y o z segun x.
    return (x & y) ^ ((0xFFFFFFFF ^ x) & z)

func sha256_maj(x: uint32, y: uint32, z: uint32) uint32:
    ; EN : Returns the SHA-256 majority function for three words.
    ;
    ; ES : Devuelve la funcion de mayoria de SHA-256 para tres palabras.
    return (x & y) ^ (x & z) ^ (y & z)

func sha256_byte_word(value: uint8) uint32:
    ; EN : Widens an unsigned octet without sign extension.
    ;
    ; ES : Amplia un octeto sin extension de signo.
    return value

@unsafe
func sha256_compress(
    block: byte[64],
    block_length: Len_t,
    block_size: Size_t,
    state: uint32[8],
    state_length: Len_t,
    state_size: Size_t,
    schedule: uint32[64],
    schedule_length: Len_t,
    schedule_size: Size_t,
    k: uint32[64],
    k_length: Len_t,
    k_size: Size_t
) void:
    ; EN : Compresses one complete 512-bit SHA-256 block into the state.
    ; The fixed arrays are bounded by their declared extents.
    ;
    ; ES : Comprime un bloque SHA-256 completo de 512 bits en el estado.
    ; Los arrays fijos estan acotados por sus extensiones declaradas.
    i: usize = 0
    while i < 16:
        j: usize = i * 4
        first: OctetView
        second: OctetView
        third: OctetView
        fourth: OctetView
        first.raw = block[j]
        second.raw = block[j + 1]
        third.raw = block[j + 2]
        fourth.raw = block[j + 3]
        first_word: uint32 = sha256_byte_word(first.numeric)
        second_word: uint32 = sha256_byte_word(second.numeric)
        third_word: uint32 = sha256_byte_word(third.numeric)
        fourth_word: uint32 = sha256_byte_word(fourth.numeric)
        schedule[i] = (first_word << 24) | (second_word << 16) | (third_word << 8) | fourth_word
        i += 1

    while i < 64:
        s0: uint32 = sha256_rotr(schedule[i - 15], 7) ^ sha256_rotr(schedule[i - 15], 18) ^ (schedule[i - 15] >> 3)
        s1: uint32 = sha256_rotr(schedule[i - 2], 17) ^ sha256_rotr(schedule[i - 2], 19) ^ (schedule[i - 2] >> 10)
        schedule[i] = schedule[i - 16] + s0 + schedule[i - 7] + s1
        i += 1

    a: uint32 = state[0]
    b: uint32 = state[1]
    c: uint32 = state[2]
    d: uint32 = state[3]
    e: uint32 = state[4]
    f: uint32 = state[5]
    g: uint32 = state[6]
    h: uint32 = state[7]
    i = 0
    while i < 64:
        round_s1: uint32 = sha256_rotr(e, 6) ^ sha256_rotr(e, 11) ^ sha256_rotr(e, 25)
        temp1: uint32 = h + round_s1 + sha256_ch(e, f, g) + k[i] + schedule[i]
        round_s0: uint32 = sha256_rotr(a, 2) ^ sha256_rotr(a, 13) ^ sha256_rotr(a, 22)
        temp2: uint32 = round_s0 + sha256_maj(a, b, c)
        h = g
        g = f
        f = e
        e = d + temp1
        d = c
        c = b
        b = a
        a = temp1 + temp2
        i += 1

    state[0] += a
    state[1] += b
    state[2] += c
    state[3] += d
    state[4] += e
    state[5] += f
    state[6] += g
    state[7] += h
    return

@unsafe
public func sha256(
    data: byte[],
    length: Len_t,
    element_size: Size_t
) SHA256Digest:
    ; EN : Computes the SHA-256 digest of a byte array.
    ; The digest is returned as eight big-endian 32-bit words.
    ; This first implementation is marked unsafe because older installed
    ; compilers do not yet prove all local fixed-array bounds.
    ;
    ; ES : Calcula el digest SHA-256 de un array de bytes.
    ; El digest se devuelve como ocho palabras de 32 bits en orden big-endian.
    ; Esta primera implementacion usa unsafe porque compiladores instalados
    ; antiguos aun no prueban todos los limites de arrays fijos locales.
    k: uint32[64] = {
        0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
        0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
        0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
        0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
        0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
        0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
        0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
        0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
        0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
        0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
        0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
        0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
        0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
        0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
        0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
        0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
    }
    state: uint32[8] = {
        0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
        0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
    }
    block: byte[64]
    schedule: uint32[64]
    block_length: usize = 0
    offset: usize = 0
    length0: uint8 = 0
    length1: uint8 = 0
    length2: uint8 = 0
    length3: uint8 = 0
    length4: uint8 = 0
    length5: uint8 = 0
    length6: uint8 = 0
    length7: uint8 = 0

    while offset < length:
        while block_length < 64 && offset < length:
            block[block_length] = data[offset]
            block_length += 1
            offset += 1
            length0 += 1
            if length0 == 0:
                length1 += 1
                if length1 == 0:
                    length2 += 1
                    if length2 == 0:
                        length3 += 1
                        if length3 == 0:
                            length4 += 1
                            if length4 == 0:
                                length5 += 1
                                if length5 == 0:
                                    length6 += 1
                                    if length6 == 0:
                                        length7 += 1
        if block_length == 64:
            sha256_compress(block, state, schedule, k)
            block_length = 0

    block[block_length] = 0x80
    block_length += 1
    if block_length > 56:
        while block_length < 64:
            block[block_length] = 0
            block_length += 1
        sha256_compress(block, state, schedule, k)
        block_length = 0
    while block_length < 56:
        block[block_length] = 0
        block_length += 1

    bit0: uint8 = length0 << 3
    bit1: uint8 = (length1 << 3) | (length0 >> 5)
    bit2: uint8 = (length2 << 3) | (length1 >> 5)
    bit3: uint8 = (length3 << 3) | (length2 >> 5)
    bit4: uint8 = (length4 << 3) | (length3 >> 5)
    bit5: uint8 = (length5 << 3) | (length4 >> 5)
    bit6: uint8 = (length6 << 3) | (length5 >> 5)
    bit7: uint8 = (length7 << 3) | (length6 >> 5)
    block[56] = bit7 as byte
    block[57] = bit6 as byte
    block[58] = bit5 as byte
    block[59] = bit4 as byte
    block[60] = bit3 as byte
    block[61] = bit2 as byte
    block[62] = bit1 as byte
    block[63] = bit0 as byte
    sha256_compress(block, state, schedule, k)

    result: SHA256Digest
    result.word0 = state[0]
    result.word1 = state[1]
    result.word2 = state[2]
    result.word3 = state[3]
    result.word4 = state[4]
    result.word5 = state[5]
    result.word6 = state[6]
    result.word7 = state[7]
    return result
