; File operations built on the canonical Windows and Linux Bagron libraries.
; Operaciones de archivo construidas sobre las librerías canónicas de Windows y Linux.
;
; File owns one native resource. Call close() explicitly or let __deletion__()
; release it when the value leaves its lifetime.
; File posee un recurso nativo. Llama a close() explícitamente o deja que
; __deletion__() lo libere al terminar su vida útil.

; EN: Validates a non-empty NUL-terminated path buffer.
; ES: Valida un buffer de ruta no vacío terminado en NUL.
;
@unsafe
private func valid_file_path(
    path: char[],
    length: Len_t,
    size: Size_t
) bool:
    if size != 1 || length < 2:
        return false

    index: usize = 0
    while index < length:
        if path[index] == 0:
            return index > 0
        index += 1

    return false

; Portable File options. Combine one access option with creation modifiers.
public FileRead: const uint32 = 1
public FileWrite: const uint32 = 2
public FileReadWrite: const uint32 = 3
public FileCreate: const uint32 = 4
public FileExclusive: const uint32 = 8
public FileTruncate: const uint32 = 16
public FileAppend: const uint32 = 32
public FileSeekStart: const int32 = 0
public FileSeekCurrent: const int32 = 1
public FileSeekEnd: const int32 = 2

#if OS, "windows"

private FileTypeDisk: const uint32 = Win.FILE_TYPE_DISK
private DefaultShareMode: const uint32 = Win.FILE_SHARE_READ_WRITE
private MaximumTransfer: const usize = 4294967295

private mold WindowsCount:
    native: uint32
    portable: usize

private mold WindowsError:
    native: uint32
    portable: int64

private mold WindowsSeekOrigin:
    native: uint32
    portable: int32

@unsafe
private func windows_error() int64:
    ; EN: Widens the current Win32 error code into the portable error representation.
    ;
    ; ES: Amplía el código de error Win32 actual a la representación de error portátil.
    result: WindowsError
    result.portable = 0
    result.native = Win.GetLastError()
    return result.portable

@unsafe
private func invalid_file_handle() HANDLE:
    ; EN: Produces a native failed handle while preserving the opaque HANDLE representation.
    ;
    ; ES: Produce un handle nativo fallido y conserva la representación HANDLE opaca.
    invalid: char[1]
    invalid[0] = "\0"
    return Win.CreateFileA(
        $invalid[0],
        Win.GENERIC_READ,
        DefaultShareMode,
        Null,
        Win.OPEN_EXISTING,
        Win.FILE_ATTRIBUTE_NORMAL,
        Null
    )

; EN: Accepts only valid disk handles, excluding console and invalid handles.
; ES: Acepta solo handles de disco válidos, excluyendo consola y handles inválidos.
;
@unsafe
private func valid_file_handle(handle: HANDLE) bool:
    return Win.GetFileType(handle) == FileTypeDisk

; EN: Translates portable File options to the native Windows CreateFile ABI.
; ES: Traduce las opciones portátiles de File a la ABI nativa CreateFile de Windows.
;
@unsafe
private func create_file(
    path: char[],
    length: Len_t,
    size: Size_t,
    options: uint32
) HANDLE:
    read_requested: bool = (options & FileRead) != 0
    write_requested: bool = (options & FileWrite) != 0
    create_requested: bool = (options & FileCreate) != 0
    exclusive_requested: bool = (options & FileExclusive) != 0
    truncate_requested: bool = (options & FileTruncate) != 0
    append_requested: bool = (options & FileAppend) != 0

    if not read_requested && not write_requested:
        return invalid_file_handle()
    if exclusive_requested && not create_requested:
        return invalid_file_handle()
    if (truncate_requested || append_requested) && not write_requested:
        return invalid_file_handle()

    desired_access: uint32 = 0
    if read_requested:
        desired_access = desired_access | Win.GENERIC_READ
    if write_requested:
        if append_requested:
            desired_access = desired_access | Win.FILE_APPEND_DATA
        else:
            desired_access = desired_access | Win.GENERIC_WRITE

    creation_disposition: uint32 = Win.OPEN_EXISTING
    if create_requested:
        if exclusive_requested:
            creation_disposition = Win.CREATE_NEW
        elif truncate_requested:
            creation_disposition = Win.CREATE_ALWAYS
        else:
            creation_disposition = Win.OPEN_ALWAYS
    elif truncate_requested:
        creation_disposition = Win.TRUNCATE_EXISTING

    if not valid_file_path(path):
        invalid: char[1]
        invalid[0] = "\0"
        return Win.CreateFileA(
            $invalid[0],
            desired_access,
            DefaultShareMode,
            Null,
            creation_disposition,
            Win.FILE_ATTRIBUTE_NORMAL,
            Null
        )

    return Win.CreateFileA(
        $path[0],
        desired_access,
        DefaultShareMode,
        Null,
        creation_disposition,
        Win.FILE_ATTRIBUTE_NORMAL,
        Null
    )

; EN: Removes a file and returns zero on success.
; ES: Elimina un archivo y devuelve cero si tiene éxito.
;
@unsafe
public func remove_file(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_file_path(path):
        return 1
    if Win.DeleteFileA($path[0]) != 0:
        return 0
    return 1

; EN: Renames a file or directory and returns zero on success.
; ES: Renombra un archivo o directorio y devuelve cero si tiene éxito.
;
@unsafe
public func rename_file(
    source: char[],
    source_length: Len_t,
    source_size: Size_t,
    target: char[],
    target_length: Len_t,
    target_size: Size_t
) int32:
    if not valid_file_path(source) || not valid_file_path(target):
        return 1
    if Win.MoveFileA($source[0], $target[0]) != 0:
        return 0
    return 1

; EN: Creates a directory and returns zero on success.
; ES: Crea un directorio y devuelve cero si tiene éxito.
;
@unsafe
public func create_directory(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_file_path(path):
        return 1
    if Win.CreateDirectoryA($path[0], Null) != 0:
        return 0
    return 1

; EN: Removes an empty directory and returns zero on success.
; ES: Elimina un directorio vacío y devuelve cero si tiene éxito.
;
@unsafe
public func remove_directory(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_file_path(path):
        return 1
    if Win.RemoveDirectoryA($path[0]) != 0:
        return 0
    return 1

; EN: Owns one opened Windows file handle and exposes binary I/O methods.
; ES: Posee un handle de archivo Windows abierto y expone I/O binaria.
;
public class File:

    ; EN: Opens a file with portable File options when the File value is constructed.
    ; ES: Abre un archivo con opciones portátiles de File al construir el valor File.
    ;
    @unsafe
    func __init__(
        path: char[],
        length: Len_t,
        size: Size_t,
        options: uint32
    ) void:
        self.resource: HANDLE = create_file(path, options)
        self.open_error: int64 = windows_error()
        self.closed: bool = false
        self.close_error: int64 = 0

    ; EN: Reports whether the owned handle is open and refers to a disk file.
    ; ES: Indica si el handle propio está abierto y refiere a un archivo de disco.
    ;
    @unsafe
    func is_open() bool:
        if self.closed:
            return false
        return valid_file_handle(self.resource)

    ; EN: Returns the portable error code captured during opening, or zero if open.
    ; ES: Devuelve el código de error portátil capturado al abrir, o cero si está abierto.
    ;
    @unsafe
    func opening_error() int64:
        if self.is_open():
            return 0
        return self.open_error

    ; EN: Returns the portable error code captured during closing.
    ; ES: Devuelve el código de error portátil capturado durante el cierre.
    ;
    func closing_error() int64:
        return self.close_error

    ; EN: Reads up to count bytes into a caller-owned buffer.
    ; ES: Lee hasta count bytes en un buffer propiedad del llamador.
    ;
    @unsafe
    func read_bytes(
        data: byte[],
        length: Len_t,
        size: Size_t,
        count: usize,
        actual *: usize
    ) bool:
        (actual) = 0
        if not self.is_open() || size != 1 || count > length || count > MaximumTransfer:
            return false
        if count == 0:
            return true
        native_count: WindowsCount
        native_count.portable = count
        native_actual: WindowsCount
        native_actual.portable = 0
        if Win.ReadFile(self.resource, $data[0], native_count.native, $native_actual.native, Null) == 0:
            return false
        (actual) = native_actual.portable
        return true

    ; EN: Writes up to count bytes from a caller-owned buffer.
    ; ES: Escribe hasta count bytes desde un buffer del llamador.
    ;
    @unsafe
    func write_bytes(
        data: byte[],
        length: Len_t,
        size: Size_t,
        count: usize,
        actual *: usize
    ) bool:
        (actual) = 0
        if not self.is_open() || size != 1 || count > length || count > MaximumTransfer:
            return false
        if count == 0:
            return true
        native_count: WindowsCount
        native_count.portable = count
        native_actual: WindowsCount
        native_actual.portable = 0
        if Win.WriteFile(self.resource, $data[0], native_count.native, $native_actual.native, Null) == 0:
            return false
        (actual) = native_actual.portable
        return true

    ; EN: Moves the file pointer and returns its new absolute position.
    ; ES: Mueve el puntero del archivo y devuelve su posición absoluta nueva.
    ;
    @unsafe
    func seek(offset: int64, origin: int32) int64:
        if not self.is_open():
            return -1
        if origin < FileSeekStart || origin > FileSeekEnd:
            return -1
        native_origin: WindowsSeekOrigin
        native_origin.portable = origin
        result: int64 = 0
        if Win.SetFilePointerEx(self.resource, offset, $result, native_origin.native) == 0:
            return -1
        return result

    ; EN: Returns the current file size in bytes.
    ; ES: Devuelve el tamaño actual del archivo en bytes.
    ;
    @unsafe
    func size() int64:
        if not self.is_open():
            return -1
        result: int64 = 0
        if Win.GetFileSizeEx(self.resource, $result) == 0:
            return -1
        return result

    ; EN: Flushes buffered file data to the Windows handle.
    ; ES: Vacía los datos almacenados hacia el handle Windows.
    ;
    @unsafe
    func flush() bool:
        if not self.is_open():
            return false
        return Win.FlushFileBuffers(self.resource) != 0

    ; EN: Closes the handle once and records a closing error if needed.
    ; ES: Cierra el handle una vez y registra el error de cierre si ocurre.
    ;
    @unsafe
    func close() void:
        if not self.closed:
            if self.is_open() && Win.CloseHandle(self.resource) == 0:
                self.close_error = windows_error()
            self.closed = true
        return

    ; EN: Releases the owned handle when the value is deleted.
    ; ES: Libera el handle propio cuando se elimina el valor.
    ;
    @unsafe
    func __deletion__() void:
        self.close()
        return

#elif OS, "linux"

private DefaultFileMode: const uint32 = 438

private mold LinuxCount:
    raw: int64
    portable: usize

; Linux x86_64 struct stat layout used only with the raw fstat syscall.
@align(8)
private struct LinuxStat:
    device: uint64
    inode: uint64
    link_count: uint64
    mode: uint32
    user_id: uint32
    group_id: uint32
    padding: uint32
    device_type: uint64
    byte_size: int64
    block_size: int64
    block_count: int64
    access_seconds: int64
    access_nanoseconds: int64
    modify_seconds: int64
    modify_nanoseconds: int64
    change_seconds: int64
    change_nanoseconds: int64
    reserved: uint64[3]

private linux_last_error: int64 = 0

; EN: Stores a negative Linux syscall error as a positive errno value.
; ES: Guarda como errno positivo un error negativo de syscall Linux.
;
@unsafe
private func remember_error(result: int64) int64:
    if result < 0:
        linux_last_error = 0 - result
    return result

; EN: Translates portable File options to raw Linux openat flags.
; ES: Traduce las opciones portátiles de File a flags raw de openat Linux.
;
@unsafe
private func create_file(
    path: char[],
    length: Len_t,
    size: Size_t,
    options: uint32
) int64:
    read_requested: bool = (options & FileRead) != 0
    write_requested: bool = (options & FileWrite) != 0
    create_requested: bool = (options & FileCreate) != 0
    exclusive_requested: bool = (options & FileExclusive) != 0
    truncate_requested: bool = (options & FileTruncate) != 0
    append_requested: bool = (options & FileAppend) != 0

    if not read_requested && not write_requested:
        linux_last_error = 22
        return -1
    if exclusive_requested && not create_requested:
        linux_last_error = 22
        return -1
    if (truncate_requested || append_requested) && not write_requested:
        linux_last_error = 22
        return -1

    open_flags: uint32 = Gnu.O_RDONLY
    if read_requested && write_requested:
        open_flags = Gnu.O_RDWR
    elif write_requested:
        open_flags = Gnu.O_WRONLY
    if create_requested:
        open_flags = open_flags | Gnu.O_CREAT
    if exclusive_requested:
        open_flags = open_flags | Gnu.O_EXCL
    if truncate_requested:
        open_flags = open_flags | Gnu.O_TRUNC
    if append_requested:
        open_flags = open_flags | Gnu.O_APPEND

    if not valid_file_path(path):
        invalid: char[1]
        invalid[0] = "\0"
        return remember_error(Gnu.openat(Gnu.AT_FDCWD, $invalid[0], open_flags, DefaultFileMode))
    return remember_error(Gnu.openat(Gnu.AT_FDCWD, $path[0], open_flags, DefaultFileMode))

; EN: Removes a file and returns zero on success.
; ES: Elimina un archivo y devuelve cero si tiene éxito.
;
@unsafe
public func remove_file(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_file_path(path):
        return 1
    if remember_error(Gnu.unlinkat(Gnu.AT_FDCWD, $path[0], 0)) == 0:
        return 0
    return 1

; EN: Renames a file or directory and returns zero on success.
; ES: Renombra un archivo o directorio y devuelve cero si tiene éxito.
;
@unsafe
public func rename_file(
    source: char[],
    source_length: Len_t,
    source_size: Size_t,
    target: char[],
    target_length: Len_t,
    target_size: Size_t
) int32:
    if not valid_file_path(source) || not valid_file_path(target):
        return 1
    if remember_error(Gnu.renameat2(
        Gnu.AT_FDCWD,
        $source[0],
        Gnu.AT_FDCWD,
        $target[0],
        0
    )) == 0:
        return 0
    return 1

; EN: Creates a directory with the standard user read/write/execute mode.
; ES: Crea un directorio con permisos estándar de lectura/escritura/ejecución.
;
@unsafe
public func create_directory(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_file_path(path):
        return 1
    if remember_error(Gnu.mkdirat(
        Gnu.AT_FDCWD,
        $path[0],
        Gnu.MODE_USER_READ_WRITE_EXEC
    )) == 0:
        return 0
    return 1

; EN: Removes an empty directory and returns zero on success.
; ES: Elimina un directorio vacío y devuelve cero si tiene éxito.
;
@unsafe
public func remove_directory(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_file_path(path):
        return 1
    if remember_error(Gnu.unlinkat(Gnu.AT_FDCWD, $path[0], Gnu.AT_REMOVEDIR)) == 0:
        return 0
    return 1

; EN: Owns one opened Linux file descriptor and exposes binary I/O methods.
; ES: Posee un descriptor de archivo Linux abierto y expone I/O binaria.
;
public class File:

    ; EN: Opens a file with portable File options when the File value is constructed.
    ; ES: Abre un archivo con opciones portátiles de File al construir el valor File.
    ;
    @unsafe
    func __init__(
        path: char[],
        length: Len_t,
        size: Size_t,
        options: uint32
    ) void:
        self.resource: int64 = create_file(path, options)
        self.open_error: int64 = linux_last_error
        self.closed: bool = false
        self.close_error: int64 = 0

    ; EN: Reports whether the owned descriptor is open.
    ; ES: Indica si el descriptor propio está abierto.
    ;
    func is_open() bool:
        if self.closed:
            return false
        return self.resource >= 0

    ; EN: Returns the raw positive errno captured during opening.
    ; ES: Devuelve el errno positivo crudo capturado al abrir.
    ;
    func opening_error() int64:
        if self.is_open():
            return 0
        return self.open_error

    ; EN: Returns the raw positive errno captured during closing.
    ; ES: Devuelve el errno positivo crudo capturado durante el cierre.
    ;
    func closing_error() int64:
        return self.close_error

    ; EN: Reads up to count bytes into a caller-owned buffer.
    ; ES: Lee hasta count bytes en un buffer propiedad del llamador.
    ;
    @unsafe
    func read_bytes(
        data: byte[],
        length: Len_t,
        size: Size_t,
        count: usize,
        actual *: usize
    ) bool:
        (actual) = 0
        if not self.is_open() || size != 1 || count > length:
            return false
        if count == 0:
            return true
        result: LinuxCount
        result.raw = remember_error(Gnu.read(self.resource, $data[0], count))
        if result.raw < 0:
            return false
        (actual) = result.portable
        return true

    ; EN: Writes up to count bytes from a caller-owned buffer.
    ; ES: Escribe hasta count bytes desde un buffer del llamador.
    ;
    @unsafe
    func write_bytes(
        data: byte[],
        length: Len_t,
        size: Size_t,
        count: usize,
        actual *: usize
    ) bool:
        (actual) = 0
        if not self.is_open() || size != 1 || count > length:
            return false
        if count == 0:
            return true
        result: LinuxCount
        result.raw = remember_error(Gnu.write(self.resource, $data[0], count))
        if result.raw < 0:
            return false
        (actual) = result.portable
        return true

    ; EN: Moves the file offset and returns its new absolute position.
    ; ES: Mueve el offset del archivo y devuelve su posición absoluta nueva.
    ;
    @unsafe
    func seek(offset: int64, origin: int32) int64:
        if not self.is_open():
            return -1
        if origin < FileSeekStart || origin > FileSeekEnd:
            return -1
        return remember_error(Gnu.lseek(self.resource, offset, origin))

    ; EN: Returns the size in bytes without changing the descriptor offset.
    ; Uses the Linux x86_64 fstat layout owned by this module.
    ;
    ; ES: Devuelve el tamaño en bytes sin cambiar el offset del descriptor.
    ; Usa el layout fstat de Linux x86_64 que posee este módulo.
    ;
    @unsafe
    func size() int64:
        if not self.is_open():
            return -1

        metadata: LinuxStat
        if remember_error(Gnu.fstat(self.resource, $metadata)) != 0:
            return -1
        return metadata.byte_size

    ; EN: Flushes file data and metadata through fsync.
    ; ES: Sincroniza datos y metadatos mediante fsync.
    ;
    @unsafe
    func flush() bool:
        if not self.is_open():
            return false
        return remember_error(Gnu.fsync(self.resource)) == 0

    ; EN: Closes the descriptor once and records a closing error if needed.
    ; ES: Cierra el descriptor una vez y registra el error si ocurre.
    ;
    @unsafe
    func close() void:
        if not self.closed:
            if self.resource >= 0 && remember_error(Gnu.close(self.resource)) != 0:
                self.close_error = linux_last_error
            self.closed = true
        return

    ; EN: Releases the owned descriptor when the value is deleted.
    ; ES: Libera el descriptor propio cuando se elimina el valor.
    ;
    @unsafe
    func __deletion__() void:
        self.close()
        return

#else

; EN: Keeps the portable file API available on unsupported targets without native I/O.
; ES: Mantiene disponible la API portátil de archivos en targets sin I/O nativo.
;
@unsafe
public func remove_file(path: char[], length: Len_t, size: Size_t) int32:
    ; EN: Reports failure because this target has no filesystem backend.
    ;
    ; ES: Reporta fallo porque este target no tiene backend de filesystem.
    return 1

@unsafe
public func rename_file(
    source: char[],
    source_length: Len_t,
    source_size: Size_t,
    target: char[],
    target_length: Len_t,
    target_size: Size_t
) int32:
    ; EN: Reports failure because this target has no filesystem backend.
    ;
    ; ES: Reporta fallo porque este target no tiene backend de filesystem.
    return 1

@unsafe
public func create_directory(path: char[], length: Len_t, size: Size_t) int32:
    ; EN: Reports failure because this target has no filesystem backend.
    ;
    ; ES: Reporta fallo porque este target no tiene backend de filesystem.
    return 1

@unsafe
public func remove_directory(path: char[], length: Len_t, size: Size_t) int32:
    ; EN: Reports failure because this target has no filesystem backend.
    ;
    ; ES: Reporta fallo porque este target no tiene backend de filesystem.
    return 1

public class File:
    ; EN: Keeps the portable File method set on unsupported targets.
    ; ES: Conserva el conjunto de métodos portátil de File en targets no compatibles.
    ;
    @unsafe
    func __init__(path: char[], length: Len_t, size: Size_t, options: uint32) void:
        ; EN: Initializes a closed placeholder because native I/O is unavailable.
        ;
        ; ES: Inicializa un marcador cerrado porque no hay I/O nativo disponible.
        self.open_error: int64 = 0
        self.close_error: int64 = 0
        self.closed: bool = true
        return

    func is_open() bool:
        ; EN: Reports that no native resource is open.
        ;
        ; ES: Indica que no hay ningún recurso nativo abierto.
        return false

    func opening_error() int64:
        ; EN: Returns zero because this placeholder does not invoke a native API.
        ;
        ; ES: Devuelve cero porque este marcador no invoca una API nativa.
        return self.open_error

    func closing_error() int64:
        ; EN: Returns zero because this placeholder never owns a native resource.
        ;
        ; ES: Devuelve cero porque este marcador nunca posee un recurso nativo.
        return self.close_error

    @unsafe
    func read_bytes(data: byte[], length: Len_t, size: Size_t, count: usize, actual *: usize) bool:
        ; EN: Reports failure and writes no bytes on unsupported targets.
        ;
        ; ES: Reporta fallo y no escribe bytes en targets no compatibles.
        (actual) = 0
        return false

    @unsafe
    func write_bytes(data: byte[], length: Len_t, size: Size_t, count: usize, actual *: usize) bool:
        ; EN: Reports failure and writes no bytes on unsupported targets.
        ;
        ; ES: Reporta fallo y no escribe bytes en targets no compatibles.
        (actual) = 0
        return false

    @unsafe
    func seek(offset: int64, origin: int32) int64:
        ; EN: Reports failure because this target has no filesystem backend.
        ;
        ; ES: Reporta fallo porque este target no tiene backend de filesystem.
        return -1

    @unsafe
    func size() int64:
        ; EN: Reports failure because this target has no filesystem backend.
        ;
        ; ES: Reporta fallo porque este target no tiene backend de filesystem.
        return -1

    @unsafe
    func flush() bool:
        ; EN: Reports failure because this target has no filesystem backend.
        ;
        ; ES: Reporta fallo porque este target no tiene backend de filesystem.
        return false

    @unsafe
    func close() void:
        ; EN: Leaves the already closed placeholder unchanged.
        ;
        ; ES: Deja sin cambios el marcador que ya está cerrado.
        self.closed = true
        return

    @unsafe
    func __deletion__() void:
        ; EN: Releases the placeholder through the portable close path.
        ;
        ; ES: Libera el marcador mediante la ruta portátil de cierre.
        self.close()
        return

#end
