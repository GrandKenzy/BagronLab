
; ============================================================
; os.bg
; Servicios generales del sistema operativo.
; Windows / Linux
;
; Operaciones de archivos, directorios, procesos y tiempo.
; I/O sincrónica para archivos ordinarios.
;
; Convención para funciones de estado:
;   0 = éxito
;   1 = error
;
; La clase File debe cerrarse mediante close() o Del.
; Las rutas deben ser arrays char terminados en NUL.
; ============================================================

; ============================================================
; VALIDACIÓN DE RUTAS
; ============================================================

@unsafe
private func valid_path(
    path: char[],
    length: Len_t,
    size: Size_t
) bool:
    if size != 1 || length < 2:
        return false

    i: usize = 0

    while i < length:
        if path[i] == 0:
            return i > 0
        i += 1

    return false


; ============================================================
; DESCRIPTORES NATIVOS
; ============================================================

; ============================================================
; WINDOWS
; ============================================================

#if OS, "windows"

; ------------------------------------------------------------
; Permisos de acceso
; ------------------------------------------------------------

public R: const uint32 = Win.GENERIC_READ
public W: const uint32 = Win.GENERIC_WRITE
public RW: const uint32 = Win.GENERIC_READ_WRITE

; ------------------------------------------------------------
; Compartición
; ------------------------------------------------------------

public ShareNone: const uint32 = Win.FILE_SHARE_NONE
public ShareR: const uint32 = Win.FILE_SHARE_READ
public ShareW: const uint32 = Win.FILE_SHARE_WRITE
public ShareRW: const uint32 = Win.FILE_SHARE_READ_WRITE
public ShareDelete: const uint32 = Win.FILE_SHARE_DELETE
public ShareAll: const uint32 = Win.FILE_SHARE_ALL

; ------------------------------------------------------------
; Apertura
; ------------------------------------------------------------

public CreateNew: const uint32 = Win.CREATE_NEW
public CreateAlways: const uint32 = Win.CREATE_ALWAYS
public OpenExisting: const uint32 = Win.OPEN_EXISTING
public OpenAlways: const uint32 = Win.OPEN_ALWAYS
public TruncateExisting: const uint32 = Win.TRUNCATE_EXISTING

; ------------------------------------------------------------
; Atributos
; ------------------------------------------------------------

public AttrReadOnly: const uint32 = Win.FILE_ATTRIBUTE_READONLY
public AttrHidden: const uint32 = Win.FILE_ATTRIBUTE_HIDDEN
public AttrSystem: const uint32 = Win.FILE_ATTRIBUTE_SYSTEM
public AttrDirectory: const uint32 = Win.FILE_ATTRIBUTE_DIRECTORY
public AttrArchive: const uint32 = Win.FILE_ATTRIBUTE_ARCHIVE
public AttrNormal: const uint32 = Win.FILE_ATTRIBUTE_NORMAL
public AttrTemporary: const uint32 = Win.FILE_ATTRIBUTE_TEMPORARY

public AttrDeleteOnClose: const uint32 = Win.FILE_FLAG_DELETE_ON_CLOSE
public InvalidFileAttributes: const uint32 = Win.INVALID_FILE_ATTRIBUTES

; ------------------------------------------------------------
; Posicionamiento
; ------------------------------------------------------------

public FileBegin: const uint32 = Win.FILE_BEGIN
public FileCurrent: const uint32 = Win.FILE_CURRENT
public FileEnd: const uint32 = Win.FILE_END

; FILE_TYPE_DISK
private FileTypeDisk: const uint32 = Win.FILE_TYPE_DISK


; ============================================================
; WINDOWS - UTILIDADES INTERNAS
; ============================================================

; La validación del handle se restringe a archivos de disco.
; Esto evita tratar INVALID_HANDLE_VALUE como un archivo.
@unsafe
private func valid_file_handle(
    handle: HANDLE
) bool:
    return Win.GetFileType(handle) == FileTypeDisk


@unsafe
private func create_file(
    path: char[],
    length: Len_t,
    size: Size_t,
    desired_access: uint32,
    share_mode: uint32,
    creation_disposition: uint32,
    flags_and_attributes: uint32
) HANDLE:
    if not valid_path(path):
        invalid: char[1]
        invalid[0] = "\0"
        return Win.CreateFileA(
            $invalid[0],
            desired_access,
            share_mode,
            Null,
            creation_disposition,
            flags_and_attributes,
            Null
        )

    return Win.CreateFileA(
        $path[0],
        desired_access,
        share_mode,
        Null,
        creation_disposition,
        flags_and_attributes,
        Null
    )

@unsafe
private func native_last_error() uint32:
    return Win.GetLastError()


; ============================================================
; WINDOWS - OPERACIONES DE ARCHIVOS
; ============================================================

@unsafe
public func remove_file(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_path(path):
        return 1

    if Win.DeleteFileA($path[0]) != 0:
        return 0

    return 1


@unsafe
public func file_exists(
    path: char[],
    length: Len_t,
    size: Size_t
) bool:
    if not valid_path(path):
        return false

    return Win.GetFileAttributesA(
        $path[0]
    ) != InvalidFileAttributes


@unsafe
public func rename_file(
    source: char[],
    source_length: Len_t,
    source_size: Size_t,
    target: char[],
    target_length: Len_t,
    target_size: Size_t
) int32:
    if not valid_path(source):
        return 1

    if not valid_path(target):
        return 1

    if Win.MoveFileA(
        $source[0],
        $target[0]
    ) != 0:
        return 0

    return 1


@unsafe
public func file_size(
    path: char[],
    length: Len_t,
    size: Size_t
) int64:
    if not valid_path(path):
        return -1

    handle: HANDLE = create_file(
        path,
        R,
        ShareRW,
        OpenExisting,
        AttrNormal
    )

    if not valid_file_handle(handle):
        return -1

    result: int64 = 0

    if Win.GetFileSizeEx(handle, $result) == 0:
        Win.CloseHandle(handle)
        return -1

    Win.CloseHandle(handle)
    return result


; ============================================================
; WINDOWS - DIRECTORIOS
; ============================================================

@unsafe
public func create_directory(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_path(path):
        return 1

    if Win.CreateDirectoryA(
        $path[0], Null
    ) != 0:
        return 0

    return 1


@unsafe
public func remove_directory(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_path(path):
        return 1

    if Win.RemoveDirectoryA($path[0]) != 0:
        return 0

    return 1


; ============================================================
; WINDOWS - PROCESO Y TIEMPO
; ============================================================

@unsafe
public func sleep_ms(milliseconds: uint32) void:
    Win.Sleep(milliseconds)
    return


@unsafe
public func yield_thread() void:
    Win.SwitchToThread()
    return


@unsafe
public func process_id() uint32:
    return Win.GetCurrentProcessId()


@unsafe
public func exit_process(code: uint32) void:
    Win.ExitProcess(code)
    return


@unsafe
public func last_error() uint32:
    return Win.GetLastError()


; ============================================================
; WINDOWS - CLASE FILE
; ============================================================

public class File:

    @unsafe
    func __init__(
        path: char[],
        length: Len_t,
        size: Size_t,
        desired_access: uint32,
        share_mode: uint32,
        creation_disposition: uint32,
        flags_and_attributes: uint32
    ) void:
        self.resource: HANDLE = create_file(
            path,
            desired_access,
            share_mode,
            creation_disposition,
            flags_and_attributes
        )
        self.open_error: uint32 = native_last_error()
        self.closed: bool = false
        self.close_error: uint32 = 0

    ; Comprueba que el archivo es válido.
    @unsafe
    func is_open() bool:
        if self.closed:
            return false

        return valid_file_handle(self.resource)

    ; Código de error de apertura.
    @unsafe
    func opening_error() uint32:
        if self.is_open():
            return 0

        return self.open_error

    func closing_error() uint32:
        return self.close_error

    ; --------------------------------------------------------
    ; Lectura binaria
    ; --------------------------------------------------------

    @unsafe
    func read_bytes(
        data: byte[],
        length: Len_t,
        size: Size_t,
        count: uint32,
        actual *: uint32
    ) bool:
        (actual) = 0

        if not self.is_open():
            return false

        if size != 1 || count > length:
            return false

        if count == 0:
            return true

        return Win.ReadFile(
            self.resource,
            $data[0],
            count,
            actual,
            Null
        ) != 0

    ; --------------------------------------------------------
    ; Escritura binaria
    ; --------------------------------------------------------

    @unsafe
    func write_bytes(
        data: byte[],
        length: Len_t,
        size: Size_t,
        count: uint32,
        actual *: uint32
    ) bool:
        (actual) = 0

        if not self.is_open():
            return false

        if size != 1 || count > length:
            return false

        if count == 0:
            return true

        return Win.WriteFile(
            self.resource,
            $data[0],
            count,
            actual,
            Null
        ) != 0

    ; --------------------------------------------------------
    ; Posición del archivo
    ; --------------------------------------------------------

    @unsafe
    func seek(
        offset: int64,
        origin: uint32
    ) int64:
        if not self.is_open():
            return -1

        result: int64 = 0

        if Win.SetFilePointerEx(
            self.resource,
            offset,
            $result,
            origin
        ) == 0:
            return -1

        return result

    ; --------------------------------------------------------
    ; Tamaño del archivo abierto
    ; --------------------------------------------------------

    @unsafe
    func size() int64:
        if not self.is_open():
            return -1

        result: int64 = 0

        if Win.GetFileSizeEx(
            self.resource,
            $result
        ) == 0:
            return -1

        return result

    ; --------------------------------------------------------
    ; Sincronización con el dispositivo
    ; --------------------------------------------------------

    @unsafe
    func flush() bool:
        if not self.is_open():
            return false

        return Win.FlushFileBuffers(
            self.resource
        ) != 0

    ; --------------------------------------------------------
    ; Cierre
    ; --------------------------------------------------------

    @unsafe
    func close() void:
        if not self.closed:
            if self.is_open():
                if Win.CloseHandle(self.resource) == 0:
                    self.close_error = native_last_error()

            self.closed = true

        return

    ; --------------------------------------------------------
    ; Destructor explícito
    ; --------------------------------------------------------

    @unsafe
    func __deletion__() void:
        self.close()
        return


; ============================================================
; LINUX
; ============================================================

#elif OS, "linux"

; ------------------------------------------------------------
; Modos de apertura
; ------------------------------------------------------------

public O_RDONLY: const uint32 = Gnu.O_RDONLY
public O_WRONLY: const uint32 = Gnu.O_WRONLY
public O_RDWR: const uint32 = Gnu.O_RDWR

public O_CREAT: const uint32 = Gnu.O_CREAT
public O_EXCL: const uint32 = Gnu.O_EXCL
public O_TRUNC: const uint32 = Gnu.O_TRUNC
public O_APPEND: const uint32 = Gnu.O_APPEND

; ------------------------------------------------------------
; Permisos
; ------------------------------------------------------------

; 0644
public MODE_USER_READ_WRITE: const uint32 = Gnu.MODE_USER_READ_WRITE

; 0755
public MODE_USER_READ_WRITE_EXEC: const uint32 = Gnu.MODE_USER_READ_WRITE_EXEC

; ------------------------------------------------------------
; Posicionamiento
; ------------------------------------------------------------

public SeekSet: const int32 = Gnu.SEEK_SET
public SeekCur: const int32 = Gnu.SEEK_CUR
public SeekEnd: const int32 = Gnu.SEEK_END

private linux_last_error: int64 = 0


; ============================================================
; LINUX - UTILIDADES INTERNAS
; ============================================================

@unsafe
private func remember_linux_error(result: int64) int64:
    if result < 0:
        linux_last_error = 0 - result
    return result

@unsafe
private func create_file(
    path: char[],
    length: Len_t,
    size: Size_t,
    open_flags: uint32,
    mode: uint32
) int64:
    if not valid_path(path):
        invalid: char[1]
        invalid[0] = "\0"
        return remember_linux_error(
            Gnu.openat(
                Gnu.AT_FDCWD,
                $invalid[0],
                open_flags,
                mode
            )
        )

    return remember_linux_error(
        Gnu.openat(
            Gnu.AT_FDCWD,
            $path[0],
            open_flags,
            mode
        )
    )


; ============================================================
; LINUX - OPERACIONES DE ARCHIVOS
; ============================================================

@unsafe
public func remove_file(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_path(path):
        return 1

    if remember_linux_error(
        Gnu.unlinkat(Gnu.AT_FDCWD, $path[0], 0)
    ) == 0:
        return 0

    return 1


@unsafe
public func file_exists(
    path: char[],
    length: Len_t,
    size: Size_t
) bool:
    if not valid_path(path):
        return false

    probe: int64 = remember_linux_error(
        Gnu.openat(
            Gnu.AT_FDCWD,
            $path[0],
            Gnu.O_PATH,
            0
        )
    )
    if probe < 0:
        return false

    remember_linux_error(Gnu.close(probe))
    return true


@unsafe
public func rename_file(
    source: char[],
    source_length: Len_t,
    source_size: Size_t,
    target: char[],
    target_length: Len_t,
    target_size: Size_t
) int32:
    if not valid_path(source):
        return 1

    if not valid_path(target):
        return 1

    if remember_linux_error(
        Gnu.renameat2(
            Gnu.AT_FDCWD,
            $source[0],
            Gnu.AT_FDCWD,
            $target[0],
            0
        )
    ) == 0:
        return 0

    return 1


@unsafe
public func file_size(
    path: char[],
    length: Len_t,
    size: Size_t
) int64:
    if not valid_path(path):
        return -1

    fd: int64 = create_file(
        path,
        O_RDONLY,
        0
    )

    if fd < 0:
        return -1

    result: int64 = remember_linux_error(
        Gnu.lseek(
            fd,
            0,
            SeekEnd
        )
    )

    remember_linux_error(Gnu.close(fd))
    return result


; ============================================================
; LINUX - DIRECTORIOS
; ============================================================

@unsafe
public func create_directory(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_path(path):
        return 1

    if remember_linux_error(
        Gnu.mkdirat(
            Gnu.AT_FDCWD,
            $path[0],
            Gnu.MODE_USER_READ_WRITE_EXEC
        )
    ) == 0:
        return 0

    return 1


@unsafe
public func remove_directory(
    path: char[],
    length: Len_t,
    size: Size_t
) int32:
    if not valid_path(path):
        return 1

    if remember_linux_error(
        Gnu.unlinkat(
            Gnu.AT_FDCWD,
            $path[0],
            Gnu.AT_REMOVEDIR
        )
    ) == 0:
        return 0

    return 1


; ============================================================
; LINUX - PROCESO Y TIEMPO
; ============================================================

@unsafe
public func sleep_ms(milliseconds: uint32) void:
    remember_linux_error(Gnu.nanosleep_ms(milliseconds))
    return


@unsafe
public func yield_thread() void:
    remember_linux_error(Gnu.sched_yield())
    return


@unsafe
public func process_id() uint32:
    return Gnu.getpid32()


@unsafe
public func exit_process(code: int32) void:
    Gnu.exit_group(code)
    return


@unsafe
public func last_error() int64:
    return linux_last_error


; ============================================================
; LINUX - CLASE FILE
; ============================================================

public class File:

    @unsafe
    func __init__(
        path: char[],
        length: Len_t,
        size: Size_t,
        open_flags: uint32,
        mode: uint32
    ) void:
        self.resource: int64 = create_file(
            path,
            open_flags,
            mode
        )
        self.open_error: int64 = last_error()
        self.closed: bool = false
        self.close_error: int64 = 0

    ; Comprueba el descriptor.
    func is_open() bool:
        if self.closed:
            return false

        return self.resource >= 0

    func opening_error() int64:
        if self.is_open():
            return 0

        return self.open_error

    func closing_error() int64:
        return self.close_error

    ; --------------------------------------------------------
    ; Lectura binaria
    ; --------------------------------------------------------

    @unsafe
    func read_bytes(
        data: byte[],
        length: Len_t,
        size: Size_t,
        count: usize,
        actual *: int64
    ) bool:
        (actual) = 0

        if not self.is_open():
            return false

        if size != 1 || count > length:
            return false

        if count == 0:
            return true

        (actual) = remember_linux_error(
            Gnu.read(
                self.resource,
                $data[0],
                count
            )
        )

        return (actual) >= 0

    ; --------------------------------------------------------
    ; Escritura binaria
    ; --------------------------------------------------------

    @unsafe
    func write_bytes(
        data: byte[],
        length: Len_t,
        size: Size_t,
        count: usize,
        actual *: int64
    ) bool:
        (actual) = 0

        if not self.is_open():
            return false

        if size != 1 || count > length:
            return false

        if count == 0:
            return true

        (actual) = remember_linux_error(
            Gnu.write(
                self.resource,
                $data[0],
                count
            )
        )

        return (actual) >= 0

    ; --------------------------------------------------------
    ; Posición del archivo
    ; --------------------------------------------------------

    @unsafe
    func seek(
        offset: int64,
        origin: int32
    ) int64:
        if not self.is_open():
            return -1

        return remember_linux_error(
            Gnu.lseek(
                self.resource,
                offset,
                origin
            )
        )

    ; --------------------------------------------------------
    ; Tamaño sin alterar la posición
    ; --------------------------------------------------------

    @unsafe
    func size() int64:
        if not self.is_open():
            return -1

        current: int64 = remember_linux_error(
            Gnu.lseek(
                self.resource,
                0,
                SeekCur
            )
        )

        if current < 0:
            return -1

        result: int64 = remember_linux_error(
            Gnu.lseek(
                self.resource,
                0,
                SeekEnd
            )
        )

        if result < 0:
            return -1

        if remember_linux_error(
            Gnu.lseek(
                self.resource,
                current,
                SeekSet
            )
        ) < 0:
            return -1

        return result

    ; --------------------------------------------------------
    ; Sincronización con el dispositivo
    ; --------------------------------------------------------

    @unsafe
    func flush() bool:
        if not self.is_open():
            return false

        return remember_linux_error(Gnu.fsync(self.resource)) == 0

    ; --------------------------------------------------------
    ; Cierre
    ; --------------------------------------------------------

    @unsafe
    func close() void:
        if not self.closed:
            if self.resource >= 0:
                if remember_linux_error(Gnu.close(self.resource)) != 0:
                    self.close_error = last_error()

            self.closed = true

        return

    ; --------------------------------------------------------
    ; Destructor explícito
    ; --------------------------------------------------------

    @unsafe
    func __deletion__() void:
        self.close()
        return

#end
