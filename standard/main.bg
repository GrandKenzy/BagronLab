#if OS, "windows"
clause System "windows"
#elif OS, "linux"
clause System "linux"
#else
clause System "auto"
#end

clause Arch "amd"

#if OS, "windows"
library "windows.lib" as Win
#elif OS, "linux"
library "gnulibrary.lib" as Gnu
#end

import {
    len,
    len_buffer,
    is_empty,
    is_empty_buffer,
    count_char,
    equals,
    equals_chain,
    equals_buffer,
    compare,
    starts_with,
    starts_with_chain,
    ends_with,
    ends_with_chain,
    find_char,
    find_last_char,
    contains_char,
    find,
    find_chain,
    contains,
    contains_chain,
    copy,
    copy_chain,
    concat,
    concat_chain,
    is_digit,
    is_lower,
    is_upper,
    is_alpha,
    is_alphanumeric,
    is_whitespace,
    char_to_upper,
    char_to_lower,
    to_upper,
    to_lower,
    fill,
    trim_right,
    trim_left,
    trim_whitespace,
    reverse,
    parse_uint,
    parse_int
} from string

@unsafe
func main() int32:
    text: char[32] = "  Hello World  "
    hello: char[16] = "Hello"
    hello_copy: char[16] = "Hello"
    prefix: char[8] = "He"
    suffix: char[8] = "lo"
    needle: char[8] = "ell"
    empty: char[1] = ""
    letter_l: char = "l"
    letter_h: char = "H"
    digit_seven: char = "7"
    lower_a: char = "a"
    upper_z: char = "Z"
    lower_q: char = "q"
    upper_q: char = "Q"
    space: char = " "
    fill_value: char = "x"
    null_char: char = "\0"

    bytes: buffer[4] = {1, 2, 3, 0}
    bytes_copy: buffer[4] = {1, 2, 3, 0}
    empty_bytes: buffer[2] = {0, 0}

    if len(text) != 15:
        return 1
    if len_buffer(bytes) != 3:
        return 2
    if is_empty(text) || not is_empty(empty):
        return 3
    if is_empty_buffer(bytes) || not is_empty_buffer(empty_bytes):
        return 4
    if count_char(text, letter_l) != 3:
        return 5

    if not equals(hello, hello_copy):
        return 6
    if not equals_chain(hello, "Hello"):
        return 7
    if not equals_buffer(bytes, bytes_copy):
        return 8
    if compare(hello, "Hello") != 0:
        return 9
    if not starts_with(hello, prefix):
        return 10
    if not starts_with_chain(hello, "Hel"):
        return 11
    if not ends_with(hello, suffix):
        return 12
    if not ends_with_chain(hello, "llo"):
        return 13

    if find_char(hello, letter_l) != 2:
        return 14
    if find_last_char(hello, letter_l) != 3:
        return 15
    if not contains_char(hello, letter_h):
        return 16
    if find(hello, needle) != 1:
        return 17
    if find_chain(hello, "lo") != 3:
        return 18
    if not contains(hello, needle):
        return 19
    if not contains_chain(hello, "ell"):
        return 20

    copied: char[16] = "seed"
    if copy(copied, hello) != 5 || not equals_chain(copied, "Hello"):
        return 21

    copied_chain: char[16] = "seed"
    if copy_chain(copied_chain, "World") != 5 || not equals_chain(copied_chain, "World"):
        return 22

    joined: char[24] = "Hello"
    if concat(joined, text) != 20 || not equals_chain(joined, "Hello  Hello World  "):
        return 23

    joined_chain: char[24] = "Hello"
    if concat_chain(joined_chain, " Bagron") != 12 || not equals_chain(joined_chain, "Hello Bagron"):
        return 24

    if not is_digit(digit_seven):
        return 25
    if not is_lower(lower_a):
        return 26
    if not is_upper(upper_z):
        return 27
    if not is_alpha(upper_q):
        return 28
    if not is_alphanumeric(digit_seven):
        return 29
    if not is_whitespace(space):
        return 30
    if char_to_upper(lower_q) != upper_q:
        return 31
    if char_to_lower(upper_q) != lower_q:
        return 32

    upper_text: char[8] = "abc"
    to_upper(upper_text)
    if not equals_chain(upper_text, "ABC"):
        return 33

    lower_text: char[8] = "XYZ"
    to_lower(lower_text)
    if not equals_chain(lower_text, "xyz"):
        return 34

    filled: char[8] = "seed"
    fill(filled, fill_value)
    if len(filled) != 7 || filled[0] != fill_value || filled[6] != fill_value || filled[7] != null_char:
        return 35

    right_trimmed: char[16] = "abc   "
    if trim_right(right_trimmed) != 3 || not equals_chain(right_trimmed, "abc"):
        return 36

    left_trimmed: char[16] = "   abc"
    if trim_left(left_trimmed) != 3 || not equals_chain(left_trimmed, "abc"):
        return 37

    trimmed: char[16] = "  abc  "
    if trim_whitespace(trimmed) != 3 || not equals_chain(trimmed, "abc"):
        return 38

    reversed: char[8] = "abcd"
    reverse(reversed)
    if not equals_chain(reversed, "dcba"):
        return 39

    unsigned_text: char[16] = "123abc"
    if parse_uint(unsigned_text) != 123:
        return 40

    signed_text: char[16] = "-42xyz"
    if parse_int(signed_text) != -42:
        return 41

    return 0
