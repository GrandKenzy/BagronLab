; Basic immediate-mode GDI drawing, not a retained rendering engine.
; Drawings may be lost on repaint. Prefer BeginPaint/EndPaint inside WM_PAINT.

; EN: Builds Windows COLORREF (0x00BBGGRR) from RGB octets.
; ES: Genera COLORREF de Windows (0x00BBGGRR).
public func rgb(red: uint32, green: uint32, blue: uint32) uint32:
    return (red & 255) | ((green & 255) << 8) | ((blue & 255) << 16)

; EN: Draws an outlined rectangle and releases the acquired device context.
; ES: Dibuja un rectángulo con el DC de ventana, liberándolo al terminar.
@unsafe
public func rectangle(hwnd: usize, x: int32, y: int32, width: int32, height: int32) bool:
    if hwnd == 0 || width <= 0 || height <= 0:
        return false
    dc: usize = Win.GetDC(hwnd)
    if dc == 0:
        return false
    ok: bool = Win.Rectangle(dc, x, y, x + width, y + height) != 0
    Win.ReleaseDC(hwnd, dc)
    return ok

; EN: Draws one line and releases the acquired device context.
; ES: Dibuja una línea y libera el contexto de dibujo.
@unsafe
public func line(hwnd: usize, x1: int32, y1: int32, x2: int32, y2: int32) bool:
    if hwnd == 0:
        return false
    dc: usize = Win.GetDC(hwnd)
    if dc == 0:
        return false
    ok: bool = Win.MoveToEx(dc, x1, y1, Null) != 0
    if ok:
        ok = Win.LineTo(dc, x2, y2) != 0
    Win.ReleaseDC(hwnd, dc)
    return ok

; EN: Draws UTF-16 text. count is the number of code units, without NUL.
; ES: Dibuja texto UTF-16, indicando unidades sin el terminador NUL.
@unsafe
public func text(hwnd: usize, x: int32, y: int32, value *: const uint16, count: int32, color: uint32) bool:
    if hwnd == 0 || count < 0:
        return false
    dc: usize = Win.GetDC(hwnd)
    if dc == 0:
        return false
    Win.SetTextColor(dc, color)
    Win.SetBkMode(dc, 1)
    ok: bool = Win.TextOutW(dc, x, y, value, count) != 0
    Win.ReleaseDC(hwnd, dc)
    return ok
