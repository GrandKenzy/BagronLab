; Library source root and public API for Bagron string operations.
; All string, alphabet, and hexadecimal symbols live in this entry module.
; Target-specific process termination is delegated to gnulibrary or windows.
; Text operations treat char[] and chain values as NUL-terminated UTF-8 byte sequences.

clause Privacy "public"

; Preserve target selection in portable lib1 source packages.
clause System "auto"
clause Arch "auto"

#if OS, "windows"
library windows as Platform
#elif OS, "linux"
library gnulibrary as Platform
#end

; ============================================================================
; Public alphabets
; ============================================================================

; EN : Public character sets for scanning, validation, and serialization.
; Each chain is an alphabet with intentional ordering and no hidden runtime logic.
;
; ES : Conjuntos de caracteres publicos para escaneo, validacion y serializacion.
; Cada cadena funciona como un alfabeto: el orden es intencional y no hay
; logica runtime escondida en este modulo.

; Bases numericas. HexadecimalString combina ambas mayusculas por comodidad.
public BinaryString: chain = "01"
public OctalString: chain = "01234567"
public NumericString: chain = "0123456789"
public HexadecimalUpperString: chain = "0123456789ABCDEF"
public HexadecimalLowerString: chain = "0123456789abcdef"
public HexadecimalString: chain = "0123456789ABCDEFabcdef"

; Variantes alfabeticas y combinaciones frecuentes.
public UppercaseAlphabetString: chain = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
public LowercaseAlphabetString: chain = "abcdefghijklmnopqrstuvwxyz"
public AlphabetString: chain = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
public AlphanumericString: chain = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
public Base36String: chain = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"

; Alfabetos de codificaciones comunes. El orden coincide con sus tablas usuales.
public Base64String: chain = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
public Base64UrlString: chain = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
public UrlSafeString: chain = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

; Casos especiales para analizadores lexicos y generadores de identificadores.
public IdentifierStartString: chain = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
public IdentifierPartString: chain = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
public SignString: chain = "+-"
public HexadecimalMarkerString: chain = "xX"
public SymbolString: chain = "+-*/%<>=!&|^~"

; ============================================================================
; Hexadecimal encoding, decoding, and formatting
; ============================================================================

; EN : Hexadecimal encoding, decoding, and digest utilities.
; Zero-allocation operations converting between raw binary data and ASCII hex.
;
; ES : Utilidades de codificacion, decodificacion y digest hexadecimal.
; Operaciones zero-allocation para conversion entre datos binarios crudos y hex ASCII.

; ============================================================================
; Atomic character inspection and conversions
; ============================================================================

@unsafe
func char_to_nibble(c: char) uint8:
    ; EN : Converts an ASCII hex character ('0'-'9', 'a'-'f', 'A'-'F') to its numeric value (0-15).
    ; Returns 255 if the character is not a valid hexadecimal digit.
    ;
    ; ES : Convierte un caracter hex ASCII ('0'-'9', 'a'-'f', 'A'-'F') a su valor numerico (0-15).
    ; Devuelve 255 si el caracter no es un digito hexadecimal valido.
    idx: uint8 = 0
    while idx < 16:
        index: usize = idx
        if HexadecimalLowerString[index] == c || HexadecimalUpperString[index] == c:
            return idx
        idx += 1

    invalid: uint8 = 255
    return invalid

@unsafe
func is_hex_char(c: char) bool:
    ; EN : Checks if a character is a valid hexadecimal digit ('0'-'9', 'a'-'f', 'A'-'F').
    ;
    ; ES : Comprueba si un caracter es un digito hexadecimal valido ('0'-'9', 'a'-'f', 'A'-'F').
    val: uint8 = char_to_nibble(c)
    return val < 16

@unsafe
func nibble_to_char_lower(nibble: uint8) char:
    ; EN : Converts a 4-bit nibble (0-15) to its lowercase hexadecimal character ('0'-'9', 'a'-'f').
    ;
    ; ES : Convierte un nibble de 4 bits (0-15) a su caracter hexadecimal en minuscula ('0'-'9', 'a'-'f').
    if nibble < 16:
        idx: usize = nibble
        return HexadecimalLowerString[idx]
    zero: char = "0"
    return zero

@unsafe
func nibble_to_char_upper(nibble: uint8) char:
    ; EN : Converts a 4-bit nibble (0-15) to its uppercase hexadecimal character ('0'-'9', 'A'-'F').
    ;
    ; ES : Convierte un nibble de 4 bits (0-15) a su caracter hexadecimal en mayuscula ('0'-'9', 'A'-'F').
    if nibble < 16:
        idx: usize = nibble
        return HexadecimalUpperString[idx]
    zero: char = "0"
    return zero

; ============================================================================
; Hexdigest encoding functions
; ============================================================================

@unsafe
func hexdigest(data: byte[], data_len: Len_t, data_sz: Size_t, dest: char[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Encodes raw bytes into a lowercase hexadecimal string in dest.
    ; Returns the number of characters written, or 0 if dest capacity is insufficient.
    ; If dest has space beyond the hex characters, a null terminator (\0) is appended.
    ;
    ; ES : Codifica bytes crudos en una cadena hexadecimal en minusculas en dest.
    ; Devuelve la cantidad de caracteres escritos, o 0 si la capacidad de dest es insuficiente.
    ; Si dest tiene espacio tras los caracteres hex, agrega un terminador nulo (\0).
    if data_sz != 1 || dest_sz != 1:
        return 0

    required: usize = data_len * 2
    if dest_len < required:
        return 0

    in_idx: usize = 0
    out_idx: usize = 0

    while in_idx < data_len:
        b: byte = data[in_idx]
        val: uint8 = b as uint8
        hi_u8: uint8 = (val >> 4) & 0x0F
        lo_u8: uint8 = val & 0x0F

        hi: usize = hi_u8
        lo: usize = lo_u8

        dest[out_idx] = HexadecimalLowerString[hi]
        dest[out_idx + 1] = HexadecimalLowerString[lo]

        out_idx += 2
        in_idx += 1

    if dest_len > required:
        dest[required] = "\0"

    return required

@unsafe
func hexdigest_upper(data: byte[], data_len: Len_t, data_sz: Size_t, dest: char[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Encodes raw bytes into an uppercase hexadecimal string in dest.
    ; Returns the number of characters written, or 0 if dest capacity is insufficient.
    ; If dest has space beyond the hex characters, a null terminator (\0) is appended.
    ;
    ; ES : Codifica bytes crudos en una cadena hexadecimal en mayusculas en dest.
    ; Devuelve la cantidad de caracteres escritos, o 0 si la capacidad de dest es insuficiente.
    ; Si dest tiene espacio tras los caracteres hex, agrega un terminador nulo (\0).
    if data_sz != 1 || dest_sz != 1:
        return 0

    required: usize = data_len * 2
    if dest_len < required:
        return 0

    in_idx: usize = 0
    out_idx: usize = 0

    while in_idx < data_len:
        b: byte = data[in_idx]
        val: uint8 = b as uint8
        hi_u8: uint8 = (val >> 4) & 0x0F
        lo_u8: uint8 = val & 0x0F

        hi: usize = hi_u8
        lo: usize = lo_u8

        dest[out_idx] = HexadecimalUpperString[hi]
        dest[out_idx + 1] = HexadecimalUpperString[lo]

        out_idx += 2
        in_idx += 1

    if dest_len > required:
        dest[required] = "\0"

    return required

@unsafe
func hexdigest_buffer(data: buffer[], data_len: Len_t, dest: char[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Encodes raw byte buffer into a lowercase hexadecimal string in dest.
    ; Returns the number of characters written, or 0 if dest capacity is insufficient.
    ; If dest has space beyond the hex characters, a null terminator (\0) is appended.
    ;
    ; ES : Codifica un buffer de bytes crudos en una cadena hexadecimal en minusculas en dest.
    ; Devuelve la cantidad de caracteres escritos, o 0 si la capacidad de dest es insuficiente.
    ; Si dest tiene espacio tras los caracteres hex, agrega un terminador nulo (\0).
    if dest_sz != 1:
        return 0

    required: usize = data_len * 2
    if dest_len < required:
        return 0

    in_idx: usize = 0
    out_idx: usize = 0

    while in_idx < data_len:
        b: byte = data[in_idx]
        val: uint8 = b as uint8
        hi_u8: uint8 = (val >> 4) & 0x0F
        lo_u8: uint8 = val & 0x0F

        hi: usize = hi_u8
        lo: usize = lo_u8

        dest[out_idx] = HexadecimalLowerString[hi]
        dest[out_idx + 1] = HexadecimalLowerString[lo]

        out_idx += 2
        in_idx += 1

    if dest_len > required:
        dest[required] = "\0"

    return required

@unsafe
func hexdigest_buffer_upper(data: buffer[], data_len: Len_t, dest: char[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Encodes raw byte buffer into an uppercase hexadecimal string in dest.
    ; Returns the number of characters written, or 0 if dest capacity is insufficient.
    ; If dest has space beyond the hex characters, a null terminator (\0) is appended.
    ;
    ; ES : Codifica un buffer de bytes crudos en una cadena hexadecimal en mayusculas en dest.
    ; Devuelve la cantidad de caracteres escritos, o 0 si la capacidad de dest es insuficiente.
    ; Si dest tiene espacio tras los caracteres hex, agrega un terminador nulo (\0).
    if dest_sz != 1:
        return 0

    required: usize = data_len * 2
    if dest_len < required:
        return 0

    in_idx: usize = 0
    out_idx: usize = 0

    while in_idx < data_len:
        b: byte = data[in_idx]
        val: uint8 = b as uint8
        hi_u8: uint8 = (val >> 4) & 0x0F
        lo_u8: uint8 = val & 0x0F

        hi: usize = hi_u8
        lo: usize = lo_u8

        dest[out_idx] = HexadecimalUpperString[hi]
        dest[out_idx + 1] = HexadecimalUpperString[lo]

        out_idx += 2
        in_idx += 1

    if dest_len > required:
        dest[required] = "\0"

    return required

; ============================================================================
; Hex decoding functions
; ============================================================================

@unsafe
func hex_decode(hex_str: char[], hex_len: Len_t, hex_sz: Size_t, dest: byte[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Decodes an ASCII hexadecimal string into raw binary bytes in dest.
    ; Stops at the first null byte (\0) or at hex_len characters.
    ; Returns the number of bytes written, or 0 if dest is too small or characters are invalid.
    ;
    ; ES : Decodifica una cadena hexadecimal ASCII en bytes binarios crudos en dest.
    ; Se detiene en el primer byte nulo (\0) o al alcanzar hex_len caracteres.
    ; Devuelve la cantidad de bytes escritos, o 0 si dest es pequeno o hay caracteres invalidos.
    if hex_sz != 1 || dest_sz != 1:
        return 0

    actual_len: usize = 0
    while actual_len < hex_len && hex_str[actual_len] != 0:
        actual_len += 1

    if (actual_len & 1) != 0:
        return 0

    required_bytes: usize = actual_len / 2
    if dest_len < required_bytes:
        return 0

    in_idx: usize = 0
    out_idx: usize = 0

    while in_idx < actual_len:
        c_hi: char = hex_str[in_idx]
        c_lo: char = hex_str[in_idx + 1]

        hi: uint8 = char_to_nibble(c_hi)
        lo: uint8 = char_to_nibble(c_lo)

        if hi > 15 || lo > 15:
            return 0

        byte_val: uint8 = (hi << 4) | lo
        dest[out_idx] = byte_val as byte

        out_idx += 1
        in_idx += 2

    return out_idx

; ============================================================================
; Scalar word formatting (big-endian)
; ============================================================================

@unsafe
func word32_to_hex(value: uint32, dest: char[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Formats a 32-bit unsigned integer into 8 lowercase hexadecimal characters (big-endian).
    ; Returns 8 on success, or 0 if dest capacity is less than 8.
    ;
    ; ES : Formatea un entero sin signo de 32 bits en 8 caracteres hexadecimales en minusculas (big-endian).
    ; Devuelve 8 en exito, o 0 si la capacidad de dest es menor a 8.
    if dest_sz != 1 || dest_len < 8:
        return 0

    shift: uint32 = 28
    idx: usize = 0

    while idx < 8:
        nibble: uint32 = (value >> shift) & 0x0F
        n_idx: usize = nibble
        dest[idx] = HexadecimalLowerString[n_idx]
        if shift >= 4:
            shift -= 4
        idx += 1

    if dest_len > 8:
        dest[8] = "\0"

    return 8

@unsafe
func word32_to_hex_upper(value: uint32, dest: char[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Formats a 32-bit unsigned integer into 8 uppercase hexadecimal characters (big-endian).
    ; Returns 8 on success, or 0 if dest capacity is less than 8.
    ;
    ; ES : Formatea un entero sin signo de 32 bits en 8 caracteres hexadecimales en mayusculas (big-endian).
    ; Devuelve 8 en exito, o 0 si la capacidad de dest es menor a 8.
    if dest_sz != 1 || dest_len < 8:
        return 0

    shift: uint32 = 28
    idx: usize = 0

    while idx < 8:
        nibble: uint32 = (value >> shift) & 0x0F
        n_idx: usize = nibble
        dest[idx] = HexadecimalUpperString[n_idx]
        if shift >= 4:
            shift -= 4
        idx += 1

    if dest_len > 8:
        dest[8] = "\0"

    return 8

@unsafe
func word64_to_hex(value: uint64, dest: char[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Formats a 64-bit unsigned integer into 16 lowercase hexadecimal characters (big-endian).
    ; Returns 16 on success, or 0 if dest capacity is less than 16.
    ;
    ; ES : Formatea un entero sin signo de 64 bits en 16 caracteres hexadecimales en minusculas (big-endian).
    ; Devuelve 16 en exito, o 0 si la capacidad de dest es menor a 16.
    if dest_sz != 1 || dest_len < 16:
        return 0

    shift: uint64 = 60
    idx: usize = 0

    while idx < 16:
        nibble: uint64 = (value >> shift) & 0x0F
        n_idx: usize = 0
        n_c: uint64 = 0
        while n_c < nibble:
            n_idx += 1
            n_c += 1
        dest[idx] = HexadecimalLowerString[n_idx]
        if shift >= 4:
            shift -= 4
        idx += 1

    if dest_len > 16:
        dest[16] = "\0"

    return 16

@unsafe
func word64_to_hex_upper(value: uint64, dest: char[], dest_len: Len_t, dest_sz: Size_t) usize:
    ; EN : Formats a 64-bit unsigned integer into 16 uppercase hexadecimal characters (big-endian).
    ; Returns 16 on success, or 0 if dest capacity is less than 16.
    ;
    ; ES : Formatea un entero sin signo de 64 bits en 16 caracteres hexadecimales en mayusculas (big-endian).
    ; Devuelve 16 en exito, o 0 si la capacidad de dest es menor a 16.
    if dest_sz != 1 || dest_len < 16:
        return 0

    shift: uint64 = 60
    idx: usize = 0

    while idx < 16:
        nibble: uint64 = (value >> shift) & 0x0F
        n_idx: usize = 0
        n_c: uint64 = 0
        while n_c < nibble:
            n_idx += 1
            n_c += 1
        dest[idx] = HexadecimalUpperString[n_idx]
        if shift >= 4:
            shift -= 4
        idx += 1

    if dest_len > 16:
        dest[16] = "\0"

    return 16

; ============================================================================
; String inspection, transformation, and numeric parsing
; ============================================================================

; Operations on text, string buffers, and character arrays in memory.

; ============================================================================
; Length and state inspection
; ============================================================================

@unsafe
public func len(text: char[], length: Len_t, size: Size_t) usize:
    ; EN : Returns the UTF-8 byte length of text up to the first null byte (\0) or buffer capacity.
    ;
    ; ES : Devuelve la longitud en bytes UTF-8 del texto hasta el primer byte nulo (\0) o la capacidad del buffer.
    if size != 1:
        return 0

    count: usize = 0
    while count < length && text[count] != 0:
        count += 1
    return count

@unsafe
public func len_buffer(data: buffer[], length: Len_t) usize:
    ; EN : Returns the length of a byte buffer up to the first null byte (\0).
    ;
    ; ES : Devuelve la longitud de un buffer de bytes hasta el primer byte nulo (\0).
    count: usize = 0
    while count < length && data[count] != 0:
        count += 1
    return count

@unsafe
public func is_empty(text: char[], length: Len_t, size: Size_t) bool:
    ; EN : Returns true if the character array is empty (zero length or first character is null).
    ;
    ; ES : Devuelve true si el array de caracteres esta vacio (longitud cero o primer caracter nulo).
    if size != 1 || length == 0:
        return true
    return text[0] == 0

@unsafe
public func is_empty_buffer(data: buffer[], length: Len_t) bool:
    ; EN : Returns true if the byte buffer is empty.
    ;
    ; ES : Devuelve true si el buffer de bytes esta vacio.
    if length == 0:
        return true
    return data[0] == 0

@unsafe
public func count_char(text: char[], length: Len_t, size: Size_t, target: char) usize:
    ; EN : Returns the number of occurrences of target within text up to the null byte.
    ;
    ; ES : Devuelve el numero de apariciones de target en el texto hasta el byte nulo.
    if size != 1:
        return 0

    total: usize = 0
    index: usize = 0
    while index < length && text[index] != 0:
        if text[index] == target:
            total += 1
        index += 1
    return total

; ============================================================================
; Comparison and equality
; ============================================================================

@unsafe
public func equals(a: char[], a_len: Len_t, a_sz: Size_t, b: char[], b_len: Len_t, b_sz: Size_t) bool:
    ; EN : Compares two character arrays for exact content equality up to null byte or buffer capacity.
    ;
    ; ES : Compara dos arrays de caracteres por igualdad exacta hasta el byte nulo o la capacidad.
    if a_sz != 1 || b_sz != 1:
        return false

    i: usize = 0
    while i < a_len && i < b_len:
        ca: char = a[i]
        cb: char = b[i]
        if ca != cb:
            return false
        if ca == 0:
            return true
        i += 1

    if i < a_len && a[i] != 0:
        return false
    if i < b_len && b[i] != 0:
        return false
    return true

@unsafe
public func equals_chain(text: char[], length: Len_t, size: Size_t, literal: chain, literal_len: Len_t) bool:
    ; EN : Compares a character array with a constant string literal for exact content equality.
    ;
    ; ES : Compara un array de caracteres con un literal constante por igualdad exacta.
    if size != 1:
        return false

    i: usize = 0
    while i < length && i < literal_len:
        ct: char = text[i]
        cl: char = literal[i]
        if ct != cl:
            return false
        if ct == 0:
            return true
        i += 1

    if i < length && text[i] != 0:
        return false
    if i < literal_len && literal[i] != 0:
        return false
    return true

@unsafe
public func equals_buffer(a: buffer[], a_len: Len_t, b: buffer[], b_len: Len_t) bool:
    ; EN : Compares two raw byte buffers for content equality up to null byte or length.
    ;
    ; ES : Compara dos buffers de bytes por contenido hasta el byte nulo o su longitud.
    i: usize = 0
    while i < a_len && i < b_len:
        ca: byte = a[i]
        cb: byte = b[i]
        if ca != cb:
            return false
        if ca == 0:
            return true
        i += 1

    if i < a_len && a[i] != 0:
        return false
    if i < b_len && b[i] != 0:
        return false
    return true

@unsafe
public func compare(a: char[], a_len: Len_t, a_sz: Size_t, b: char[], b_len: Len_t, b_sz: Size_t) int32:
    ; EN : Performs lexicographical comparison. Returns -1 if a < b, 0 if a == b, and 1 if a > b.
    ;
    ; ES : Compara lexicograficamente. Devuelve -1 si a < b, 0 si a == b y 1 si a > b.
    if a_sz != 1 || b_sz != 1:
        return 0

    i: usize = 0
    while i < a_len && i < b_len:
        ca: char = a[i]
        cb: char = b[i]
        if ca < cb:
            return -1
        if ca > cb:
            return 1
        if ca == 0:
            return 0
        i += 1

    has_a: bool = i < a_len && a[i] != 0
    has_b: bool = i < b_len && b[i] != 0
    if has_a:
        return 1
    if has_b:
        return -1
    return 0

@unsafe
public func starts_with(text: char[], t_len: Len_t, t_sz: Size_t, prefix: char[], p_len: Len_t, p_sz: Size_t) bool:
    ; EN : Checks if text begins with the specified prefix character array.
    ;
    ; ES : Comprueba si el texto comienza con el array de caracteres indicado como prefijo.
    if t_sz != 1 || p_sz != 1:
        return false

    i: usize = 0
    while i < p_len && prefix[i] != 0:
        if i >= t_len || text[i] != prefix[i]:
            return false
        i += 1
    return true

@unsafe
public func starts_with_chain(text: char[], length: Len_t, size: Size_t, prefix: chain, prefix_len: Len_t) bool:
    ; EN : Checks if text begins with the specified constant string literal prefix.
    ;
    ; ES : Comprueba si el texto comienza con el literal constante indicado como prefijo.
    if size != 1:
        return false

    i: usize = 0
    while i < prefix_len && prefix[i] != 0:
        if i >= length || text[i] != prefix[i]:
            return false
        i += 1
    return true

@unsafe
public func ends_with(text: char[], t_len: Len_t, t_sz: Size_t, suffix: char[], s_len: Len_t, s_sz: Size_t) bool:
    ; EN : Checks if text ends with the specified suffix character array.
    ;
    ; ES : Comprueba si el texto termina con el array de caracteres indicado como sufijo.
    if t_sz != 1 || s_sz != 1:
        return false

    t_real_len: usize = len(text)
    s_real_len: usize = len(suffix)
    if s_real_len > t_real_len:
        return false

    offset: usize = t_real_len - s_real_len
    i: usize = 0
    while i < s_real_len:
        if text[offset + i] != suffix[i]:
            return false
        i += 1
    return true

@unsafe
public func ends_with_chain(text: char[], length: Len_t, size: Size_t, suffix: chain, suffix_len: Len_t) bool:
    ; EN : Checks if text ends with the specified constant string literal suffix.
    ;
    ; ES : Comprueba si el texto termina con el literal constante indicado como sufijo.
    if size != 1:
        return false

    t_real_len: usize = len(text)
    s_real_len: usize = 0
    while s_real_len < suffix_len && suffix[s_real_len] != 0:
        s_real_len += 1

    if s_real_len > t_real_len:
        return false

    offset: usize = t_real_len - s_real_len
    i: usize = 0
    while i < s_real_len:
        if text[offset + i] != suffix[i]:
            return false
        i += 1
    return true

; ============================================================================
; Search and inspection
; ============================================================================

@unsafe
public func find_char(text: char[], length: Len_t, size: Size_t, target: char) isize:
    ; EN : Returns the zero-based index of the first occurrence of target, or -1 if not found.
    ;
    ; ES : Devuelve el indice base cero de la primera aparicion de target, o -1 si no existe.
    if size != 1:
        return -1

    idx: usize = 0
    s_idx: isize = 0
    while idx < length && text[idx] != 0:
        if text[idx] == target:
            return s_idx
        idx += 1
        s_idx += 1
    return -1

@unsafe
public func find_last_char(text: char[], length: Len_t, size: Size_t, target: char) isize:
    ; EN : Returns the zero-based index of the last occurrence of target, or -1 if not found.
    ;
    ; ES : Devuelve el indice base cero de la ultima aparicion de target, o -1 si no existe.
    if size != 1:
        return -1

    idx: usize = 0
    s_idx: isize = 0
    last_found: isize = -1
    while idx < length && text[idx] != 0:
        if text[idx] == target:
            last_found = s_idx
        idx += 1
        s_idx += 1
    return last_found

@unsafe
public func contains_char(text: char[], length: Len_t, size: Size_t, target: char) bool:
    ; EN : Returns true if target character exists within text, false otherwise.
    ;
    ; ES : Devuelve true si el caracter target existe en el texto y false en caso contrario.
    idx: isize = find_char(text, target)
    return idx != -1

@unsafe
public func find(text: char[], t_len: Len_t, t_sz: Size_t, needle: char[], n_len: Len_t, n_sz: Size_t) isize:
    ; EN : Returns the zero-based index of the first occurrence of needle in text, or -1 if not found.
    ;
    ; ES : Devuelve el indice base cero de la primera aparicion de needle, o -1 si no existe.
    if t_sz != 1 || n_sz != 1:
        return -1

    sub_len: usize = len(needle)
    if sub_len == 0:
        return 0

    idx: usize = 0
    s_idx: isize = 0
    while idx < t_len && text[idx] != 0:
        match: bool = true
        j: usize = 0
        while j < sub_len:
            pos: usize = idx + j
            if pos >= t_len || text[pos] != needle[j]:
                match = false
                break
            j += 1
        if match:
            return s_idx
        idx += 1
        s_idx += 1
    return -1

@unsafe
public func find_chain(text: char[], length: Len_t, size: Size_t, needle: chain, needle_len: Len_t) isize:
    ; EN : Returns the zero-based index of the first occurrence of needle literal in text, or -1 if not found.
    ;
    ; ES : Devuelve el indice base cero de la primera aparicion del literal needle, o -1 si no existe.
    if size != 1:
        return -1

    sub_len: usize = 0
    while sub_len < needle_len && needle[sub_len] != 0:
        sub_len += 1

    if sub_len == 0:
        return 0

    idx: usize = 0
    s_idx: isize = 0
    while idx < length && text[idx] != 0:
        match: bool = true
        j: usize = 0
        while j < sub_len:
            pos: usize = idx + j
            if pos >= length || text[pos] != needle[j]:
                match = false
                break
            j += 1
        if match:
            return s_idx
        idx += 1
        s_idx += 1
    return -1

@unsafe
public func contains(text: char[], t_len: Len_t, t_sz: Size_t, needle: char[], n_len: Len_t, n_sz: Size_t) bool:
    ; EN : Returns true if needle character array is found within text, false otherwise.
    ;
    ; ES : Devuelve true si el array de caracteres needle aparece en el texto y false en caso contrario.
    idx: isize = find(text, needle)
    return idx != -1

@unsafe
public func contains_chain(text: char[], length: Len_t, size: Size_t, needle: chain, needle_len: Len_t) bool:
    ; EN : Returns true if needle literal is found within text, false otherwise.
    ;
    ; ES : Devuelve true si el literal needle aparece en el texto y false en caso contrario.
    idx: isize = find_chain(text, needle)
    return idx != -1

; ============================================================================
; Safe Copy and Concatenation without Truncation
; ============================================================================

@unsafe
public func copy(dest: char[], dest_len: Len_t, dest_sz: Size_t, src: char[], src_len: Len_t, src_sz: Size_t) usize:
    ; EN : Copies characters from src into dest without truncating. Traps if dest buffer is too small.
    ;
    ; ES : Copia caracteres de src en dest sin truncar. Ejecuta trap si el destino es demasiado pequeno.
    if dest_sz != 1 || src_sz != 1:
        Platform.trap()
        return 0

    s_len: usize = len(src)
    required_len: usize = s_len + 1
    if required_len > dest_len:
        Platform.trap()
        return 0

    idx: usize = 0
    while idx < s_len:
        dest[idx] = src[idx]
        idx += 1

    dest[s_len] = "\0"
    return s_len

@unsafe
public func copy_chain(dest: char[], dest_len: Len_t, dest_sz: Size_t, src: chain, src_len: Len_t) usize:
    ; EN : Copies characters from a string literal into dest without truncating. Traps if dest buffer is too small.
    ;
    ; ES : Copia caracteres de un literal en dest sin truncar. Ejecuta trap si el destino es demasiado pequeno.
    if dest_sz != 1:
        Platform.trap()
        return 0

    s_len: usize = 0
    while s_len < src_len && src[s_len] != 0:
        s_len += 1

    required_len: usize = s_len + 1
    if required_len > dest_len:
        Platform.trap()
        return 0

    idx: usize = 0
    while idx < s_len:
        dest[idx] = src[idx]
        idx += 1

    dest[s_len] = "\0"
    return s_len

@unsafe
public func concat(dest: char[], dest_len: Len_t, dest_sz: Size_t, src: char[], src_len: Len_t, src_sz: Size_t) usize:
    ; EN : Concatenates src to the end of dest without truncating. Traps if dest buffer is too small.
    ;
    ; ES : Concatena src al final de dest sin truncar. Ejecuta trap si el destino es demasiado pequeno.
    if dest_sz != 1 || src_sz != 1:
        Platform.trap()
        return 0

    d_len: usize = len(dest)
    s_len: usize = len(src)
    total_len: usize = d_len + s_len
    required_len: usize = total_len + 1
    if required_len > dest_len:
        Platform.trap()
        return 0

    idx: usize = 0
    while idx < s_len:
        dest[d_len + idx] = src[idx]
        idx += 1

    dest[total_len] = "\0"
    return total_len

@unsafe
public func concat_chain(dest: char[], dest_len: Len_t, dest_sz: Size_t, src: chain, src_len: Len_t) usize:
    ; EN : Concatenates a string literal to the end of dest without truncating. Traps if dest buffer is too small.
    ;
    ; ES : Concatena un literal al final de dest sin truncar. Ejecuta trap si el destino es demasiado pequeno.
    if dest_sz != 1:
        Platform.trap()
        return 0

    d_len: usize = len(dest)
    s_len: usize = 0
    while s_len < src_len && src[s_len] != 0:
        s_len += 1

    total_len: usize = d_len + s_len
    required_len: usize = total_len + 1
    if required_len > dest_len:
        Platform.trap()
        return 0

    idx: usize = 0
    while idx < s_len:
        dest[d_len + idx] = src[idx]
        idx += 1

    dest[total_len] = "\0"
    return total_len

; ============================================================================
; ASCII Character Classification & Conversion
; ============================================================================

@unsafe
public inline func is_digit(c: char) bool:
    ; EN : Checks if character is an ASCII decimal digit ('0' to '9').
    ;
    ; ES : Comprueba si el caracter es un digito decimal ASCII ('0' a '9').
    zero: char = "0"
    nine: char = "9"
    return c >= zero && c <= nine

@unsafe
public inline func is_lower(c: char) bool:
    ; EN : Checks if character is an ASCII lowercase letter ('a' to 'z').
    ;
    ; ES : Comprueba si el caracter es una letra minuscula ASCII ('a' a 'z').
    a: char = "a"
    z: char = "z"
    return c >= a && c <= z

@unsafe
public inline func is_upper(c: char) bool:
    ; EN : Checks if character is an ASCII uppercase letter ('A' to 'Z').
    ;
    ; ES : Comprueba si el caracter es una letra mayuscula ASCII ('A' a 'Z').
    a: char = "A"
    z: char = "Z"
    return c >= a && c <= z

@unsafe
public inline func is_alpha(c: char) bool:
    ; EN : Checks if character is an ASCII alphabetic letter ('a'-'z' or 'A'-'Z').
    ;
    ; ES : Comprueba si el caracter es una letra alfabetica ASCII ('a'-'z' o 'A'-'Z').
    return is_lower(c) || is_upper(c)

@unsafe
public inline func is_alphanumeric(c: char) bool:
    ; EN : Checks if character is an ASCII alphanumeric character (letter or digit).
    ;
    ; ES : Comprueba si el caracter es alfanumerico ASCII (letra o digito).
    return is_alpha(c) || is_digit(c)

@unsafe
public inline func is_whitespace(c: char) bool:
    ; EN : Checks if character is an ASCII whitespace character (space, tab, newline, carriage return).
    ;
    ; ES : Comprueba si el caracter es espacio ASCII (espacio, tabulador, salto de linea o retorno de carro).
    sp: char = " "
    tb: char = "\t"
    nl: char = "\n"
    cr: char = "\r"
    return c == sp || c == tb || c == nl || c == cr

@unsafe
public func char_to_upper(c: char) char:
    ; EN : Converts a lowercase ASCII character to uppercase.
    ;
    ; ES : Convierte un caracter ASCII minusculo a mayuscula.
    if is_lower(c):
        lower: chain = "abcdefghijklmnopqrstuvwxyz"
        upper: chain = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        idx: usize = 0
        while idx < 26:
            if lower[idx] == c:
                return upper[idx]
            idx += 1
    return c

@unsafe
public func char_to_lower(c: char) char:
    ; EN : Converts an uppercase ASCII character to lowercase.
    ;
    ; ES : Convierte un caracter ASCII mayusculo a minuscula.
    if is_upper(c):
        lower: chain = "abcdefghijklmnopqrstuvwxyz"
        upper: chain = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        idx: usize = 0
        while idx < 26:
            if upper[idx] == c:
                return lower[idx]
            idx += 1
    return c

; ============================================================================
; In-Place Transformations
; ============================================================================

@unsafe
public func to_upper(data: char[], length: Len_t, size: Size_t) void:
    ; EN : Converts all lowercase ASCII characters in data to uppercase in-place.
    ;
    ; ES : Convierte en sitio todos los caracteres ASCII minusculos de data a mayusculas.
    if size != 1:
        return

    idx: usize = 0
    while idx < length && data[idx] != 0:
        data[idx] = char_to_upper(data[idx])
        idx += 1
    return

@unsafe
public func to_lower(data: char[], length: Len_t, size: Size_t) void:
    ; EN : Converts all uppercase ASCII characters in data to lowercase in-place.
    ;
    ; ES : Convierte en sitio todos los caracteres ASCII mayusculos de data a minusculas.
    if size != 1:
        return

    idx: usize = 0
    while idx < length && data[idx] != 0:
        data[idx] = char_to_lower(data[idx])
        idx += 1
    return

@unsafe
public func fill(data: char[], length: Len_t, size: Size_t, value: char) void:
    ; EN : Fills the buffer with value up to length - 1 and ensures null-termination.
    ;
    ; ES : Rellena el buffer con value hasta length - 1 y garantiza la terminacion nula.
    if size != 1 || length == 0:
        return

    max_fill: usize = length - 1
    idx: usize = 0
    while idx < max_fill:
        data[idx] = value
        idx += 1

    data[max_fill] = "\0"
    return

@unsafe
public func trim_right(data: char[], length: Len_t, size: Size_t) usize:
    ; EN : Trims trailing whitespace in-place by writing null terminator. Returns new length.
    ;
    ; ES : Elimina espacios finales en sitio escribiendo un terminador nulo. Devuelve la nueva longitud.
    if size != 1 || length == 0:
        return 0

    curr_len: usize = len(data)
    if curr_len == 0:
        return 0

    idx: usize = curr_len
    while idx > 0:
        prev: usize = idx - 1
        if !is_whitespace(data[prev]):
            break
        data[prev] = "\0"
        idx = prev
    return idx

@unsafe
public func trim_left(data: char[], length: Len_t, size: Size_t) usize:
    ; EN : Trims leading whitespace in-place by shifting remaining characters left. Returns new length.
    ;
    ; ES : Elimina espacios iniciales en sitio desplazando los caracteres restantes a la izquierda. Devuelve la nueva longitud.
    if size != 1 || length == 0:
        return 0

    curr_len: usize = len(data)
    if curr_len == 0:
        return 0

    start: usize = 0
    while start < curr_len && is_whitespace(data[start]):
        start += 1

    if start == 0:
        return curr_len

    new_len: usize = curr_len - start
    idx: usize = 0
    while idx < new_len:
        data[idx] = data[start + idx]
        idx += 1

    data[new_len] = "\0"
    return new_len

@unsafe
public func trim_whitespace(data: char[], length: Len_t, size: Size_t) usize:
    ; EN : Trims both leading and trailing whitespace in-place. Returns new length.
    ;
    ; ES : Elimina espacios iniciales y finales en sitio. Devuelve la nueva longitud.
    trim_right(data)
    return trim_left(data)

@unsafe
public func reverse(data: char[], length: Len_t, size: Size_t) void:
    ; EN : Reverses the characters within the buffer in-place.
    ;
    ; ES : Invierte en sitio los caracteres del buffer.
    if size != 1 || length < 2:
        return

    left: usize = 0
    right: usize = len(data)
    if right < 2:
        return
    right -= 1

    while left < right:
        temporary: char = data[left]
        data[left] = data[right]
        data[right] = temporary
        left += 1
        right -= 1
    return

; ============================================================================
; Numeric Parsing
; ============================================================================

@unsafe
public func parse_uint(text: char[], length: Len_t, size: Size_t) usize:
    ; EN : Parses an unsigned decimal integer from text up to first non-digit character.
    ;
    ; ES : Analiza un entero decimal sin signo hasta el primer caracter que no sea un digito.
    if size != 1 || length == 0:
        return 0

    idx: usize = 0
    zero: char = "0"
    nine: char = "9"
    result: usize = 0
    digits: chain = "0123456789"

    while idx < length && text[idx] != 0:
        c: char = text[idx]
        if c < zero || c > nine:
            break

        digit: usize = 0
        d_idx: usize = 0
        while d_idx < 10:
            if digits[d_idx] == c:
                digit = d_idx
                break
            d_idx += 1

        result = result * 10 + digit
        idx += 1

    return result

@unsafe
public func parse_int(text: char[], length: Len_t, size: Size_t) isize:
    ; EN : Parses a signed decimal integer from text up to first non-digit character.
    ;
    ; ES : Analiza un entero decimal con signo hasta el primer caracter que no sea un digito.
    if size != 1 || length == 0:
        return 0

    idx: usize = 0
    negative: bool = false
    minus: char = "-"
    plus: char = "+"

    if text[0] == minus:
        negative = true
        idx = 1
    elif text[0] == plus:
        idx = 1

    zero: char = "0"
    nine: char = "9"
    result: isize = 0
    digits: chain = "0123456789"

    while idx < length && text[idx] != 0:
        c: char = text[idx]
        if c < zero || c > nine:
            break

        digit: isize = 0
        d_idx: usize = 0
        s_d_idx: isize = 0
        while d_idx < 10:
            if digits[d_idx] == c:
                digit = s_d_idx
                break
            d_idx += 1
            s_d_idx += 1

        result = result * 10 + digit
        idx += 1

    if negative:
        return 0 - result
    return result
