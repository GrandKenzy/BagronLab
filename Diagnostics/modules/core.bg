; Allocation-free diagnostic records and bounded diagnostic storage for Bagron.

; Severity values follow DiagnosticsLite so tools can map records without a
; translation table.
public SeverityDebug: const uint32 = 0
public SeverityAdvice: const uint32 = 1
public SeverityWarning: const uint32 = 2
public SeverityError: const uint32 = 3
public SeverityFatal: const uint32 = 4

public PolicyRecover: const uint32 = 0
public PolicyStopOnError: const uint32 = 1
public PolicyStopOnFatal: const uint32 = 2

public CodeNone: const uint32 = 0
public CodeEmptyKeywords: const uint32 = 1
public CodeKeywordAlreadyExists: const uint32 = 2
public CodeKeywordNotFound: const uint32 = 3
public CodeGroupNotFound: const uint32 = 4
public CodeKeywordInvalidName: const uint32 = 5
public CodeUnexpectedCharacter: const uint32 = 6
public CodeUnclosedString: const uint32 = 7
public CodeIndentationMismatch: const uint32 = 8
public CodeInvalidNumber: const uint32 = 9
public CodeWordGroupAlreadyExists: const uint32 = 10
public CodeWordGroupNotFound: const uint32 = 11
public CodeWordGroupKeywordNotRegistered: const uint32 = 12
public CodeFileNotFound: const uint32 = 13
public CodeInvalidUtf8: const uint32 = 14
public CodeInvalidCommentSymbol: const uint32 = 15
public CodeCustomBase: const uint32 = 1000
; Recommended default size for a caller-owned message arena. The value is not a
; hard limit; `buffer_set_message_arena` accepts any capacity.
public MessageStorageCapacity: const usize = 4096

; EN : Describes one diagnostic and locates its message in the buffer arena.
; The record remains valid while its DiagnosticBuffer remains alive.
;
; ES : Describe un diagnóstico y localiza su mensaje en la arena del buffer.
; El registro es válido mientras viva su DiagnosticBuffer.
public struct Diagnostic:
    code: uint32
    severity: uint32
    start: uint32
    end: uint32
    line: uint32
    column: uint32
    message_offset: usize
    message_length: usize

; EN : Overrides the default severity for one diagnostic code.
; ES : Sobrescribe la severidad predeterminada de un código de diagnóstico.
public struct SeverityOverride:
    code: uint32
    severity: uint32

; EN : Owns metadata and counters for a caller-owned message arena; item,
; override, and arena storage stay with the caller. The buffer never allocates
; or releases external regions.
;
; ES : Posee metadatos y contadores para un arena de mensajes del llamador; los
; registros, overrides y arena siguen siendo del llamador. El buffer nunca
; asigna ni libera regiones externas.
public struct DiagnosticBuffer:
    items *: Diagnostic
    capacity: usize
    count: usize
    total_emitted: usize
    dropped_count: usize
    max_diagnostics: usize
    policy: uint32
    halted: bool
    error_count: usize
    fatal_count: usize
    overrides *: SeverityOverride
    override_count: usize
    message_storage_capacity: usize
    message_storage_used: usize

@unsafe
private func copy_chars(
    source: char[],
    source_length: Len_t,
    source_size: Size_t,
    source_start: usize,
    target: char[],
    target_length: Len_t,
    target_size: Size_t,
    target_start: usize,
    count: usize
) bool:
    ; EN : Copies a bounded character range between caller-owned arrays.
    ;
    ; ES : Copia un rango acotado de caracteres entre arrays del llamador.
    if source_size != 1 || target_size != 1:
        return false
    if source_start > source_length || count > source_length - source_start:
        return false
    if target_start > target_length || count > target_length - target_start:
        return false
    copy_index: usize = 0
    while copy_index < count:
        target[target_start + copy_index] = source[source_start + copy_index]
        copy_index += 1
    return true

@unsafe
public func buffer_init(
    buffer *: DiagnosticBuffer,
    storage *: Diagnostic,
    capacity: usize,
    policy: uint32
) void:
    ; EN : Initializes a caller-owned diagnostic buffer without allocating memory.
    ; `storage` must remain valid for the lifetime of the buffer. `capacity` is the
    ; number of Diagnostic records available at that pointer.
    ;
    ; ES : Inicializa un buffer de diagnósticos propiedad del llamador sin asignar
    ; memoria. `storage` debe seguir válido durante toda la vida del buffer y
    ; `capacity` indica cuántos registros hay desde ese puntero.
    (buffer).items = storage
    (buffer).capacity = capacity
    (buffer).count = 0
    (buffer).total_emitted = 0
    (buffer).dropped_count = 0
    (buffer).max_diagnostics = 0
    (buffer).policy = policy
    (buffer).halted = false
    (buffer).error_count = 0
    (buffer).fatal_count = 0
    (buffer).overrides = Null
    (buffer).override_count = 0
    (buffer).message_storage_capacity = 0
    (buffer).message_storage_used = 0
    return

@unsafe
public func buffer_reset(buffer *: DiagnosticBuffer) void:
    ; EN : Resets counters and halt state while preserving storage and policy.
    ;
    ; ES : Restablece contadores y estado de parada conservando almacenamiento y política.
    (buffer).count = 0
    (buffer).total_emitted = 0
    (buffer).dropped_count = 0
    (buffer).halted = false
    (buffer).error_count = 0
    (buffer).fatal_count = 0
    (buffer).message_storage_used = 0
    return

@unsafe
public func buffer_set_message_arena(
    buffer *: DiagnosticBuffer,
    capacity: usize
) void:
    ; EN : Configures the capacity of caller-owned message storage.
    ; The same `char[]` arena must be passed to each emit and copy operation.
    ; Changing the configured capacity also resets its used byte count.
    ;
    ; ES : Configura la capacidad del almacenamiento de mensajes del llamador.
    ; El mismo arena `char[]` debe pasarse a cada operación de emisión y copia.
    ; Cambiar la capacidad configurada también restablece los bytes utilizados.
    (buffer).message_storage_capacity = capacity
    (buffer).message_storage_used = 0
    return

@unsafe
public func buffer_message_arena_remaining(buffer *: DiagnosticBuffer) usize:
    ; EN : Returns the number of bytes still available in the message arena.
    ;
    ; ES : Devuelve los bytes que quedan disponibles en el arena de mensajes.
    if (buffer).message_storage_used >= (buffer).message_storage_capacity:
        return 0
    return (buffer).message_storage_capacity - (buffer).message_storage_used

@unsafe
public func buffer_set_max_limit(
    buffer *: DiagnosticBuffer,
    max_diagnostics: usize
) void:
    ; EN : Sets a hard emission limit; zero means only storage capacity limits it.
    ;
    ; ES : Establece un límite duro de emisiones; cero deja solo el límite de almacenamiento.
    (buffer).max_diagnostics = max_diagnostics
    return

@unsafe
public func buffer_set_overrides(
    buffer *: DiagnosticBuffer,
    overrides *: SeverityOverride,
    count: usize
) void:
    ; EN : Attaches caller-owned per-code severity overrides.
    ; `count` is the number of entries available at the pointer.
    ;
    ; ES : Conecta overrides de severidad por código propiedad del llamador.
    ; `count` indica cuántas entradas hay desde ese puntero.
    (buffer).overrides = overrides
    (buffer).override_count = count
    return

@unsafe
public func resolve_severity(
    code: uint32,
    default_severity: uint32,
    overrides *: SeverityOverride,
    override_count: usize
) uint32:
    ; EN : Resolves a code-specific severity, falling back to the supplied default.
    ;
    ; ES : Resuelve la severidad específica de un código o devuelve la predeterminada.
    index: usize = 0
    while index < override_count:
        if overrides[index].code == code:
            return overrides[index].severity
        index += 1
    return default_severity

public inline func should_halt(severity: uint32, policy: uint32) bool:
    ; EN : Returns whether a severity activates the selected stop policy.
    ;
    ; ES : Devuelve si una severidad activa la política de parada seleccionada.
    if policy == PolicyStopOnError:
        return severity >= SeverityError
    if policy == PolicyStopOnFatal:
        return severity >= SeverityFatal
    return false

@unsafe
public func buffer_is_halted(buffer *: DiagnosticBuffer) bool:
    ; EN : Returns the current halt state of a diagnostic buffer.
    ;
    ; ES : Devuelve el estado actual de parada de un buffer de diagnósticos.
    return (buffer).halted

@unsafe
public func emit(
    buffer *: DiagnosticBuffer,
    code: uint32,
    severity: uint32,
    start: uint32,
    end: uint32,
    line: uint32,
    column: uint32,
    message: char[],
    message_length: Len_t,
    message_size: Size_t,
    arena: char[],
    arena_length: Len_t,
    arena_size: Size_t
) bool:
    ; EN : Emits one bounded diagnostic and returns true when it is stored.
    ; The source text is copied into the caller-owned message arena.
    ; An arena overflow is counted as a dropped emission.
    ;
    ; ES : Emite un diagnóstico acotado y devuelve true cuando queda almacenado.
    ; El texto origen se copia al arena de mensajes propiedad del llamador.
    ; Un desbordamiento de la arena cuenta como emisión descartada.
    if message_size != 1:
        return false
    effective: uint32 = severity
    if (buffer).override_count > 0:
        effective = resolve_severity(
            code,
            severity,
            (buffer).overrides,
            (buffer).override_count
        )

    if effective == SeverityError:
        (buffer).error_count += 1
    elif effective == SeverityFatal:
        (buffer).fatal_count += 1
    if should_halt(effective, (buffer).policy):
        (buffer).halted = true

    if (buffer).max_diagnostics > 0 && (buffer).total_emitted >= (buffer).max_diagnostics:
        (buffer).total_emitted += 1
        (buffer).dropped_count += 1
        return false

    (buffer).total_emitted += 1
    if (buffer).capacity == 0 || (buffer).count >= (buffer).capacity:
        (buffer).dropped_count += 1
        return false

    record: Diagnostic
    record.code = code
    record.severity = effective
    record.start = start
    record.end = end
    record.line = line
    record.column = column
    record.message_offset = 0
    record.message_length = 0
    zero: char = "\0"

    copy_length: usize = message_length
    if copy_length > 0 && message[copy_length - 1] == 0:
        copy_length -= 1
    if copy_length > 0:
        if arena_size != 1 || arena_length < (buffer).message_storage_capacity:
            (buffer).dropped_count += 1
            return false
        remaining: usize = buffer_message_arena_remaining(buffer)
        if copy_length + 1 > remaining:
            (buffer).dropped_count += 1
            return false
        arena_index: usize = (buffer).message_storage_used
        if not copy_chars(message, 0, arena, arena_index, copy_length):
            (buffer).dropped_count += 1
            return false
        arena[arena_index + copy_length] = zero
        record.message_offset = arena_index
        record.message_length = copy_length
        (buffer).message_storage_used += copy_length + 1
    (buffer).items[(buffer).count].code = record.code
    (buffer).items[(buffer).count].severity = record.severity
    (buffer).items[(buffer).count].start = record.start
    (buffer).items[(buffer).count].end = record.end
    (buffer).items[(buffer).count].line = record.line
    (buffer).items[(buffer).count].column = record.column
    (buffer).items[(buffer).count].message_offset = record.message_offset
    (buffer).items[(buffer).count].message_length = record.message_length
    (buffer).count += 1
    return true
@unsafe
public func buffer_read(
    buffer *: DiagnosticBuffer,
    index: usize,
    destination *: Diagnostic
) bool:
    ; EN : Copies one stored record into caller-owned output storage.
    ;
    ; ES : Copia un registro almacenado al almacenamiento de salida del llamador.
    if index >= (buffer).count:
        return false
    (destination).code = (buffer).items[index].code
    (destination).severity = (buffer).items[index].severity
    (destination).start = (buffer).items[index].start
    (destination).end = (buffer).items[index].end
    (destination).line = (buffer).items[index].line
    (destination).column = (buffer).items[index].column
    (destination).message_offset = (buffer).items[index].message_offset
    (destination).message_length = (buffer).items[index].message_length
    return true

@unsafe
public func buffer_message_copy(
    buffer *: DiagnosticBuffer,
    index: usize,
    arena: char[],
    arena_length: Len_t,
    arena_size: Size_t,
    output: char[],
    output_length: Len_t,
    output_size: Size_t
) usize:
    ; EN : Copies a stored UTF-8 message into caller-owned character storage.
    ; The result excludes the terminating NUL and truncates to the destination.
    ;
    ; ES : Copia un mensaje UTF-8 almacenado a caracteres del llamador.
    ; El resultado excluye el NUL final y se trunca según el destino.
    zero: char = "\0"
    if output_size != 1 || output_length == 0:
        return 0
    if index >= (buffer).count:
        output[0] = zero
        return 0
    record_offset: usize = (buffer).items[index].message_offset
    record_length: usize = (buffer).items[index].message_length
    if record_offset > (buffer).message_storage_capacity:
        output[0] = zero
        return 0
    if record_length > (buffer).message_storage_capacity - record_offset:
        output[0] = zero
        return 0
    if record_length > 0 && (arena_size != 1 || arena_length < (buffer).message_storage_capacity):
        output[0] = zero
        return 0
    copy_length: usize = record_length
    if copy_length + 1 > output_length:
        copy_length = output_length - 1
    if copy_length == 0:
        output[0] = zero
        return 0
    if not copy_chars(arena, record_offset, output, 0, copy_length):
        output[0] = zero
        return 0
    output[copy_length] = zero
    return copy_length
